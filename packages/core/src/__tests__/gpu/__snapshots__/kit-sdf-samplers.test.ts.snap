exports[`kit/sdf3d createAnalytic3dSdfSetup (b) baked sdfFn resolves > SVG-3D extrusion sdfFn (samples the sdfSource DATA texture) + march + kernel resolve (snapshot) 1`] = `
"@group(0) @binding(2) var sdfSource: texture_2d<f32>;

struct RotStruct {
  cx: f32,
  sx: f32,
  cy: f32,
  sy: f32,
  cz: f32,
  sz: f32,
}

struct MarchParams {
  @align(16) @size(32) rot: RotStruct,
  rBound: f32,
  spanX: f32,
  spanY: f32,
  originX: f32,
  originY: f32,
  activeRes: u32,
  pA: f32,
  pB: f32,
  pC: f32,
  pD: f32,
  mb0: vec3f,
  mb1: vec3f,
  mb2: vec3f,
  mb3: vec3f,
  mb4: vec3f,
  mb5: vec3f,
  mb6: vec3f,
  mb7: vec3f,
}

@group(0) @binding(1) var<uniform> params: MarchParams;

@group(0) @binding(4) var<storage, read> svgGrid: array<u32, 262144>;

@group(0) @binding(3) var<storage, read> svgSegs: array<vec4f, 8192>;

fn item(p: vec3f) -> f32 {
  let SIZE_F = f32(textureDimensions(sdfSource).x);
  let MAX_TEXEL = (SIZE_F - 1f);
  let pp = (&params);
  let halfDepth2 = (*pp).pA;
  let bevel2 = (*pp).pB;
  let u = (((p.x + 0.5f) * SIZE_F) - 0.5f);
  let v = (((0.5f - p.y) * SIZE_F) - 0.5f);
  let x0 = floor(u);
  let y0 = floor(v);
  let fx = (u - x0);
  let fy = (v - y0);
  let cx0 = u32(clamp(x0, 0f, MAX_TEXEL));
  let cx1 = u32(clamp((x0 + 1f), 0f, MAX_TEXEL));
  let cy0 = u32(clamp(y0, 0f, MAX_TEXEL));
  let cy1 = u32(clamp((y0 + 1f), 0f, MAX_TEXEL));
  let s00 = textureLoad(sdfSource, vec2u(cx0, cy0), 0).r;
  let s10 = textureLoad(sdfSource, vec2u(cx1, cy0), 0).r;
  let s01 = textureLoad(sdfSource, vec2u(cx0, cy1), 0).r;
  let s11 = textureLoad(sdfSource, vec2u(cx1, cy1), 0).r;
  let bilinear = mix(mix(s00, s10, fx), mix(s01, s11, fx), fy);
  let texel = (1f / SIZE_F);
  let wallBand = ((1f - smoothstep((6f * texel), (10f * texel), bilinear)) * (1f - smoothstep((6f * texel), (10f * texel), ((bilinear * -1f) - bevel2))));
  var field2d = bilinear;
  if ((wallBand > 0f)) {
    if (((*pp).pC > 0.5f)) {
      let qx = (p.x + 0.5f);
      let qy = (0.5f - p.y);
      const gridF = 64f;
      let gcx = u32(clamp(floor((qx * gridF)), 0f, (gridF - 1f)));
      let gcy = u32(clamp(floor((qy * gridF)), 0f, (gridF - 1f)));
      let cell = ((gcy * 64u) + gcx);
      let start = svgGrid[(cell * 2u)];
      let count = svgGrid[((cell * 2u) + 1u)];
      var bestD = 1000f;
      var bestPerp = 0f;
      for (var k = 0u; (k < count); k++) {
        let seg = (&svgSegs[svgGrid[(start + k)]]);
        let abx = ((*seg).z - (*seg).x);
        let aby = ((*seg).w - (*seg).y);
        let apx = (qx - (*seg).x);
        let apy = (qy - (*seg).y);
        let len2 = max(((abx * abx) + (aby * aby)), 1e-12f);
        let h = clamp((((apx * abx) + (apy * aby)) / len2), 0f, 1f);
        let ex = (apx - (abx * h));
        let ey = (apy - (aby * h));
        let dist = sqrt(((ex * ex) + (ey * ey)));
        let perp = (((apx * aby) - (apy * abx)) / sqrt(len2));
        var take = 0f;
        if ((dist < (bestD - 1e-7f))) {
          take = 1f;
        }
        if ((dist < (bestD + 1e-7f))) {
          if ((abs(perp) > abs(bestPerp))) {
            take = 1f;
          }
        }
        if ((take > 0.5f)) {
          bestD = dist;
          bestPerp = perp;
        }
      }
      if ((bestD < 999f)) {
        let signedSeg = select(bestD, (bestD * -1f), (bestPerp > 0f));
        let signedField = select(bestD, (bestD * -1f), (bilinear < 0f));
        let exact = select(signedSeg, signedField, (abs(bilinear) > (2f * texel)));
        field2d = mix(bilinear, exact, wallBand);
      }
    }
    else {
      let ox = (1f - fx);
      let bx0 = (((ox * ox) * ox) * 0.16666667f);
      let bx1 = (((((fx * fx) * fx) * 0.5f) - (fx * fx)) + 0.66666667f);
      let bx2 = ((((((fx * fx) * fx) * -0.5f) + ((fx * fx) * 0.5f)) + (fx * 0.5f)) + 0.16666667f);
      let bx3 = (((fx * fx) * fx) * 0.16666667f);
      let oy = (1f - fy);
      let by0 = (((oy * oy) * oy) * 0.16666667f);
      let by1 = (((((fy * fy) * fy) * 0.5f) - (fy * fy)) + 0.66666667f);
      let by2 = ((((((fy * fy) * fy) * -0.5f) + ((fy * fy) * 0.5f)) + (fy * 0.5f)) + 0.16666667f);
      let by3 = (((fy * fy) * fy) * 0.16666667f);
      let cxm = u32(clamp((x0 - 1f), 0f, MAX_TEXEL));
      let cx2 = u32(clamp((x0 + 2f), 0f, MAX_TEXEL));
      let cym = u32(clamp((y0 - 1f), 0f, MAX_TEXEL));
      let cy2 = u32(clamp((y0 + 2f), 0f, MAX_TEXEL));
      let rowM = ((((textureLoad(sdfSource, vec2u(cxm, cym), 0).r * bx0) + (textureLoad(sdfSource, vec2u(cx0, cym), 0).r * bx1)) + (textureLoad(sdfSource, vec2u(cx1, cym), 0).r * bx2)) + (textureLoad(sdfSource, vec2u(cx2, cym), 0).r * bx3));
      let row0 = ((((textureLoad(sdfSource, vec2u(cxm, cy0), 0).r * bx0) + (s00 * bx1)) + (s10 * bx2)) + (textureLoad(sdfSource, vec2u(cx2, cy0), 0).r * bx3));
      let row1 = ((((textureLoad(sdfSource, vec2u(cxm, cy1), 0).r * bx0) + (s01 * bx1)) + (s11 * bx2)) + (textureLoad(sdfSource, vec2u(cx2, cy1), 0).r * bx3));
      let row2 = ((((textureLoad(sdfSource, vec2u(cxm, cy2), 0).r * bx0) + (textureLoad(sdfSource, vec2u(cx0, cy2), 0).r * bx1)) + (textureLoad(sdfSource, vec2u(cx1, cy2), 0).r * bx2)) + (textureLoad(sdfSource, vec2u(cx2, cy2), 0).r * bx3));
      field2d = mix(bilinear, ((((rowM * by0) + (row0 * by1)) + (row1 * by2)) + (row2 * by3)), wallBand);
    }
  }
  let d2 = (field2d + bevel2);
  let wz = ((abs(p.z) - halfDepth2) + bevel2);
  let inner = min(max(d2, wz), 0f);
  let outer = length(vec2f(max(d2, 0f), max(wz, 0f)));
  return ((inner + outer) - bevel2);
}

fn rotateVec3(v: vec3f, rot: RotStruct) -> vec3f {
  let x1 = ((v.x * rot.cy) + (v.z * rot.sy));
  let z1 = ((v.z * rot.cy) - (v.x * rot.sy));
  let y2 = ((v.y * rot.cx) - (z1 * rot.sx));
  let z2 = ((v.y * rot.sx) + (z1 * rot.cx));
  let x3 = ((x1 * rot.cz) - (y2 * rot.sz));
  let y3 = ((x1 * rot.sz) + (y2 * rot.cz));
  return vec3f(x3, y3, z2);
}

fn raymarchedField(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let ro0 = vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f);
  let rd0 = vec3f(0, 0, 1);
  let ro = rotateVec3(ro0, rot);
  let rd = rotateVec3(rd0, rot);
  let steps = i32(clamp((rBound * 220f), 96f, 384f));
  let b = dot(ro, rd);
  let perp = sqrt(max((dot(ro, ro) - (b * b)), 0f));
  let halfSpan = sqrt(max(((rBound * rBound) - (perp * perp)), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  var t = tStart;
  var tPrev = tStart;
  var minD = 10f;
  var tMinD = tStart;
  var hit = 0f;
  for (var i = 0; (i < steps); i++) {
    let p = (ro + (rd * t));
    let dd = item(p);
    if ((dd < minD)) {
      minD = dd;
      tMinD = t;
    }
    if ((dd < 0f)) {
      hit = 1f;
      break;
    }
    if ((t > tEnd)) {
      break;
    }
    tPrev = t;
    t = (t + max(dd, 2e-3f));
  }
  if (((hit < 0.5f) && (minD < 0.15f))) {
    let reach = (max(minD, 2e-3f) * 2f);
    var lo = (tMinD - reach);
    var hi = (tMinD + reach);
    for (var i = 0; (i < 5i); i++) {
      let m1 = (hi - ((hi - lo) * 0.618034f));
      let m2 = (lo + ((hi - lo) * 0.618034f));
      let f1 = item((ro + (rd * m1)));
      let f2 = item((ro + (rd * m2)));
      if ((f1 < f2)) {
        hi = m2;
      }
      else {
        lo = m1;
      }
    }
    minD = min(minD, item((ro + (rd * ((lo + hi) * 0.5f)))));
  }
  var fieldVal = minD;
  let patternU = 0f;
  let patternV = 0f;
  var viewDepth = (tEnd + 0.4f);
  if ((hit > 0.5f)) {
    var eLo = tPrev;
    var eHi = t;
    var dLo = item((ro + (rd * eLo)));
    var dHi = item((ro + (rd * eHi)));
    for (var i = 0; (i < 10i); i++) {
      let mid = ((eLo + eHi) * 0.5f);
      let dm = item((ro + (rd * mid)));
      if ((dm > 0f)) {
        eLo = mid;
        dLo = dm;
      }
      else {
        eHi = mid;
        dHi = dm;
      }
    }
    let tEnter = (eLo + ((eHi - eLo) * clamp((dLo / max((dLo - dHi), 1e-9f)), 0f, 1f)));
    var tExit = tEnter;
    {
      let roB = (ro + (rd * tEnd));
      let span = ((tEnd - tStart) + 0.01f);
      var s = 0f;
      var sPrev = 0f;
      for (var i = 0; (i < steps); i++) {
        let p = (roB - (rd * s));
        let dd = item(p);
        if ((dd < 0f)) {
          break;
        }
        if ((s > span)) {
          break;
        }
        sPrev = s;
        s = (s + max(dd, 2e-3f));
      }
      var xLo = sPrev;
      var xHi = s;
      var hLo = item((roB - (rd * xLo)));
      var hHi = item((roB - (rd * xHi)));
      for (var i = 0; (i < 10i); i++) {
        let mid = ((xLo + xHi) * 0.5f);
        let dm = item((roB - (rd * mid)));
        if ((dm > 0f)) {
          xLo = mid;
          hLo = dm;
        }
        else {
          xHi = mid;
          hHi = dm;
        }
      }
      tExit = (tEnd - (xLo + ((xHi - xLo) * clamp((hLo / max((hLo - hHi), 1e-9f)), 0f, 1f))));
    }
    let halfChord = (max((tExit - tEnter), 0f) * 0.5f);
    fieldVal = (halfChord * -1f);
    viewDepth = tEnter;
  }
  return vec4f(fieldVal, patternU, patternV, viewDepth);
}

@group(0) @binding(0) var field_1: texture_storage_2d<rgba32float, write>;

fn volumetricFieldMarch(cx: u32, cy: u32) {
  let p = (&params);
  let activeResF = f32((*p).activeRes);
  let uv = vec2f(((*p).originX + (((f32(cx) + 0.5f) / activeResF) * (*p).spanX)), ((*p).originY + (((f32(cy) + 0.5f) / activeResF) * (*p).spanY)));
  let field = raymarchedField(uv, (*p).rot, (*p).rBound);
  textureStore(field_1, vec2u(cx, cy), field);
}"
