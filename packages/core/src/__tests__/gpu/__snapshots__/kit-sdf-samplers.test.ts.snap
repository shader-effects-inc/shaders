fn analyticSdf_circleSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
  let dx = (uv.x - 0.5f);
  let dy = (uv.y - 0.5f);
  let rotRad = (rot * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = circleSdf(rdx, rdy, r);
  return vec4f(dist, 0f, 0f, 1f);
}

fn polygonSdf(dx: f32, dy: f32, radius: f32, sides: f32) -> f32 {
  let len = sqrt(((dx * dx) + (dy * dy)));
  let angle = atan2(dy, dx);
  let sectorAngle = (6.283185307179586f / sides);
  let sectorIdx = floor(((angle / sectorAngle) + 0.5f));
  let canonicalAngle = (angle - (sectorIdx * sectorAngle));
  return ((len * cos(canonicalAngle)) - radius);
}

fn analyticSdf_polygonSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
  let dx = (uv.x - 0.5f);
  let dy = (uv.y - 0.5f);
  let rotRad = (rot * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = mix(polygonSdf(rdx, rdy, r, n), circleSdf(rdx, rdy, r), round_1);
  return vec4f(dist, 0f, 0f, 1f);
}

fn starSdf(dx: f32, dy: f32, outerRadius: f32, sides: f32, innerRatio: f32) -> f32 {
  let innerRadius = (outerRadius * innerRatio);
  let len = sqrt(((dx * dx) + (dy * dy)));
  let angle = atan2(dy, dx);
  let sectorAngle = (6.283185307179586f / sides);
  let sectorIdx = floor(((angle / sectorAngle) + 0.5f));
  let bn = (angle - (sectorIdx * sectorAngle));
  let fpx = abs((len * sin(bn)));
  let fpy = (len * cos(bn));
  let an = (3.141592653589793f / sides);
  let sinAn = sin(an);
  let cosAn = cos(an);
  let ex = (innerRadius * sinAn);
  let ey = ((innerRadius * cosAn) - outerRadius);
  let qx = fpx;
  let qy = (fpy - outerRadius);
  let dotQE = ((qx * ex) + (qy * ey));
  let dotEE = ((ex * ex) + (ey * ey));
  let t = clamp((dotQE / dotEE), 0f, 1f);
  let nx = (fpx - (ex * t));
  let ny = (fpy - (outerRadius + (ey * t)));
  let dist = sqrt(((nx * nx) + (ny * ny)));
  let cross_1 = ((ex * qy) - (ey * qx));
  return (dist * sign(cross_1));
}

fn analyticSdf_starSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
