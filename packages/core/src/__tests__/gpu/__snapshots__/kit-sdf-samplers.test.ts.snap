  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = parallelogramSdf(rdx, rdy, r, h, off);
  return vec4f(dist, 0f, 0f, 1f);
}"
