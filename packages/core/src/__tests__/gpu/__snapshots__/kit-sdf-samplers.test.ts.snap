}

fn heartSdf(dx: f32, dy: f32, radius: f32) -> f32 {
  let S = (radius / 0.75f);
  let px = (abs(dx) / S);
  let py = (((dy * -1f) / S) + 0.6f);
  let ax = (px - 0.25f);
  let ay = (py - 0.75f);
  let distA = (sqrt(((ax * ax) + (ay * ay))) - 0.35355339059327373f);
  let b1y = (py - 1f);
  let dot1 = ((px * px) + (b1y * b1y));
  let m = (max((px + py), 0f) * 0.5f);
  let b2x = (px - m);
  let b2y = (py - m);
  let dot2v = ((b2x * b2x) + (b2y * b2y));
  let distB = (sqrt(min(dot1, dot2v)) * sign((px - py)));
  return (select(distB, distA, ((px + py) > 1f)) * S);
}

fn analyticSdf_heartSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
  let dx = (uv.x - 0.5f);
