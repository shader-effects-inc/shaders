  return vec4f(dist, 0f, 0f, 1f);
}

fn trapezoidSdf(dx: f32, dy: f32, r1: f32, r2: f32, he: f32) -> f32 {
  let px = abs(dx);
  let k1x = r2;
  let k1y = he;
  let k2x = (r2 - r1);
  let k2y = (he * 2f);
  let clampWidth = select(r2, r1, (dy < 0f));
  let cax = (px - min(px, clampWidth));
  let cay = (abs(dy) - he);
  let diffX = (k1x - px);
  let diffY = (k1y - dy);
  let dotNum = ((diffX * k2x) + (diffY * k2y));
  let dotDen = max(((k2x * k2x) + (k2y * k2y)), 1e-4f);
  let t = clamp((dotNum / dotDen), 0f, 1f);
  let cbx = ((px - k1x) + (k2x * t));
  let cby = ((dy - k1y) + (k2y * t));
  let sInner = select(1f, -1f, (cay < 0f));
  let s = select(1f, sInner, (cbx < 0f));
  let dca = ((cax * cax) + (cay * cay));
  let dcb = ((cbx * cbx) + (cby * cby));
  return (s * sqrt(min(dca, dcb)));
}

fn analyticSdf_trapezoidSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
