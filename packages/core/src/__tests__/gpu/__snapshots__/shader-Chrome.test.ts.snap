fn roundedRectSdf(dx: f32, dy: f32, width: f32, height: f32, rounding: f32) -> f32 {
  let qx = ((abs(dx) - width) + rounding);
  let qy = ((abs(dy) - height) + rounding);
  let mqx = max(qx, 0f);
  let mqy = max(qy, 0f);
  let outerDist = sqrt(((mqx * mqx) + (mqy * mqy)));
  let innerDist = min(max(qx, qy), 0f);
  return ((outerDist + innerDist) - rounding);
}

fn analyticSdf_roundedRectSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
  let dx = (uv.x - 0.5f);
  let dy = (uv.y - 0.5f);
  let rotRad = (rot * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = roundedRectSdf(rdx, rdy, r, h, round_1);
  return vec4f(dist, 0f, 0f, 1f);
}

fn outsideShape(sdf: f32, pxH: f32) -> bool {
  return (sdf > (pxH * 2f));
}

fn perspectiveViewRay(uv: vec2f, aspect: f32, fov: f32) -> vec3f {
  return normalize(vec3f((((uv.x - 0.5f) * aspect) * fov), ((uv.y - 0.5f) * fov), 1f));
