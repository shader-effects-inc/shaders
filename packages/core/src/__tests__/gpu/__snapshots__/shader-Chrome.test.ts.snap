  let gb = ((hash22((i + vec2f(1, 0))) * 2f) - 1f);
  let gc = ((hash22((i + vec2f(0, 1))) * 2f) - 1f);
  let gd = ((hash22((i + vec2f(1))) * 2f) - 1f);
  let va = dot(ga, (f - vec2f()));
  let vb = dot(gb, (f - vec2f(1, 0)));
  let vc = dot(gc, (f - vec2f(0, 1)));
  let vd = dot(gd, (f - vec2f(1)));
