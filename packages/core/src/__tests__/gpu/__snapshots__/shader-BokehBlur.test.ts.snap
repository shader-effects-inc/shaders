// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BokehBlur (a) compute → RTT input → fragment composite > RTTs the child, registers a compute-output texture, and samples the defocused buffer > final-pass 1`] = `
"struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  radius: f32,
  highlightGain: f32,
  highlightThreshold: f32,
  bladeCount: f32,
  bladeRotation: f32,
  chromaticFringe: f32,
  catEye: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_bokeh: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(0) var compute_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  _ = uniforms._sys.time;
  var uv = in.uv;
  var composed_0 = unpremultiplyAlpha(textureSample(compute_0, linearClamp, uv));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;

exports[`BokehBlur (c) gather kernels resolve > uniform-radius kernel resolves with a sampled textureLoad + storage textureStore + tap table > bokehGather 1`] = `
"@group(0) @binding(0) var input: texture_2d<f32>;

@group(0) @binding(1) var output: texture_storage_2d<rgba16float, write>;

struct item {
  radius: f32,
  highlightGain: f32,
  highlightThreshold: f32,
  rotCos: f32,
  rotSin: f32,
  chromaticFringe: f32,
  catEye: f32,
  inputWidth: f32,
  inputHeight: f32,
}

@group(0) @binding(2) var<uniform> params: item;

@group(0) @binding(3) var<uniform> taps: array<vec4f, 64>;

fn bokehHighlightWeight(base: vec4f, threshold: f32, gain: f32, rim: f32) -> f32 {
  let lum = dot(base.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let hi = smoothstep(threshold, (threshold + 0.35f), lum);
  return ((1f + ((gain * hi) * hi)) * rim);
}

fn bokehGather(cx: u32, cy: u32) {
  let p = (&params);
  let radius = (*p).radius;
  let inputCx = ((((f32(cx) + 0.5f) * (*p).inputWidth) / 1024f) - 0.5f);
  let inputCy = ((((f32(cy) + 0.5f) * (*p).inputHeight) / 640f) - 0.5f);
  let inputWm1 = i32(((*p).inputWidth - 1f));
  let inputHm1 = i32(((*p).inputHeight - 1f));
  if ((radius < 0.5f)) {
    let sx = clamp(i32(round(inputCx)), 0i, inputWm1);
    let sy = clamp(i32(round(inputCy)), 0i, inputHm1);
    let texel = textureLoad(input, vec2u(u32(sx), u32(sy)), 0);
    textureStore(output, vec2u(cx, cy), texel);
  }
  else {
    let gain = (*p).highlightGain;
    let threshold = (*p).highlightThreshold;
    let fringe = (*p).chromaticFringe;
    let rotC = (*p).rotCos;
    let rotS = (*p).rotSin;
    let aspect = ((*p).inputWidth / (*p).inputHeight);
    let vu = ((((f32(cx) + 0.5f) / 1024f) - 0.5f) * aspect);
    let vv = (((f32(cy) + 0.5f) / 640f) - 0.5f);
    let vLen = sqrt(((vu * vu) + (vv * vv)));
    let vMax = sqrt((((0.25f * aspect) * aspect) + 0.25f));
    let shift = ((((*p).catEye * (vLen / vMax)) * 1.4f) / max(vLen, 1e-4f));
    let barrelShift = vec2f((vu * shift), (vv * shift));
    var accum = vec3f();
    var alphaAccum = 0f;
    var wSum = 0f;
    for (var i = 0; (i < 64i); i++) {
      let tap = (&taps[i]);
      let ox = (((*tap).x * rotC) - ((*tap).y * rotS));
      let oy = (((*tap).x * rotS) + ((*tap).y * rotC));
      let off = vec2f((ox * radius), (oy * radius));
      let sx = clamp(i32(round((inputCx + off.x))), 0i, inputWm1);
      let sy = clamp(i32(round((inputCy + off.y))), 0i, inputHm1);
      let base = textureLoad(input, vec2u(u32(sx), u32(sy)), 0);
      var colR = base.x;
      var colB = base.z;
      if ((fringe > 1e-3f)) {
        let offR = (off * (1f + (fringe * 0.5f)));
        let rx = clamp(i32(round((inputCx + offR.x))), 0i, inputWm1);
        let ry = clamp(i32(round((inputCy + offR.y))), 0i, inputHm1);
        colR = textureLoad(input, vec2u(u32(rx), u32(ry)), 0).x;
        let offB = (off * (1f - (fringe * 0.5f)));
        let bx = clamp(i32(round((inputCx + offB.x))), 0i, inputWm1);
        let by = clamp(i32(round((inputCy + offB.y))), 0i, inputHm1);
        colB = textureLoad(input, vec2u(u32(bx), u32(by)), 0).z;
      }
      let col = vec3f(colR, base.y, colB);
      let barrel = (1f - smoothstep(1.02f, 1.12f, length((vec2f(ox, oy) + barrelShift))));
      let w = (bokehHighlightWeight(base, threshold, gain, (*tap).z) * barrel);
      accum = (accum + (col * w));
      alphaAccum = (alphaAccum + (base.w * w));
      wSum = (wSum + w);
    }
    let invW = (1f / max(wSum, 1e-4f));
    textureStore(output, vec2u(cx, cy), vec4f((accum * invW), (alphaAccum * invW)));
  }
}"
`;
