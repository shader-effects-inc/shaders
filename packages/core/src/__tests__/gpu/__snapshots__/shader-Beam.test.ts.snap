// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Beam (a) linear color path (no preconversion) > mixes endpoints per-pixel via mixColors — no preconverted reads > final-pass-linear 1`] = `
"fn geom_aspectOf(viewport: vec2f) -> f32 {
  return (viewport.x / max(viewport.y, 1e-6f));
}

fn lightfields_pointToSegment(p: vec2f, a: vec2f, b: vec2f) -> vec2f {
  let lineVec = vec2f((b.x - a.x), (b.y - a.y));
  let toPoint = vec2f((p.x - a.x), (p.y - a.y));
  let dotProduct = ((toPoint.x * lineVec.x) + (toPoint.y * lineVec.y));
  let lineLengthSq = ((lineVec.x * lineVec.x) + (lineVec.y * lineVec.y));
  let t = clamp((dotProduct / max(lineLengthSq, 1e-4f)), 0f, 1f);
  let closestPoint = vec2f((a.x + (lineVec.x * t)), (a.y + (lineVec.y * t)));
  let distVec = vec2f((p.x - closestPoint.x), (p.y - closestPoint.y));
  return vec2f(t, sqrt(((distVec.x * distVec.x) + (distVec.y * distVec.y))));
}

fn lightfields_taperedSegmentGlow(dist: f32, t: f32, startThickness: f32, endThickness: f32, startSoftness: f32, endSoftness: f32) -> vec2f {
  let thickness = mix(startThickness, endThickness, t);
  let softness = max(mix(startSoftness, endSoftness, t), 1e-4f);
  let normalizedDist = (dist / max(thickness, 1e-4f));
  let edgeEnd = (1f + softness);
  let alphaBase = (1f - smoothstep(1f, edgeEnd, normalizedDist));
  let softnessFactor = (1f + (softness * 1.5f));
  let alpha = pow(alphaBase, softnessFactor);
  let colorGradientStart = (1f - softness);
  let colorGradientEnd = (1f + softness);
  let colorT = smoothstep(colorGradientStart, colorGradientEnd, normalizedDist);
  return vec2f(colorT, alpha);
}

fn beamField(uv: vec2f, vp: vec2f, start: vec2f, end: vec2f, startThickness: f32, endThickness: f32, startSoftness: f32, endSoftness: f32) -> vec2f {
  let aspect = geom_aspectOf(vp);
  let startPos = vec2f(start.x, (1f - start.y));
  let endPos = vec2f(end.x, (1f - end.y));
  let acStart = vec2f((startPos.x * aspect), startPos.y);
  let acEnd = vec2f((endPos.x * aspect), endPos.y);
  let acUV = vec2f((uv.x * aspect), uv.y);
  let proj = lightfields_pointToSegment(acUV, acStart, acEnd);
  let field = lightfields_taperedSegmentGlow(proj.y, proj.x, (startThickness * 0.25f), (endThickness * 0.25f), startSoftness, endSoftness);
  let colorT = field.x;
  let alpha = field.y;
  return vec2f(colorT, alpha);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  startPosition: vec2f,
  endPosition: vec2f,
  startThickness: f32,
  endThickness: f32,
  startSoftness: f32,
  endSoftness: f32,
  insideColor: vec4f,
  outsideColor: vec4f,
  colorSpace: f32,
  _opacity: f32,
  convA: vec3f,
  convB: vec3f,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_beam: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn mixColors(colorA: vec4f, colorB: vec4f, t: f32) -> vec4f {
  let weightA = (colorA.w * (1f - t));
  let weightB = (colorB.w * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let rgb = awMix(colorA.xyz, colorB.xyz, weightA, weightB, safeWeight);
  return vec4f(rgb, totalWeight);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let beamField_0 = beamField(uv, uniforms._sys.viewportSize, uniforms.n_beam.startPosition, uniforms.n_beam.endPosition, uniforms.n_beam.startThickness, uniforms.n_beam.endThickness, uniforms.n_beam.startSoftness, uniforms.n_beam.endSoftness);
  var composed_1 = vec4f((mixColors(uniforms.n_beam.insideColor, uniforms.n_beam.outsideColor, beamField_0.x)).rgb, (((uniforms.n_beam.insideColor.a + uniforms.n_beam.outsideColor.a) * 0.5) * beamField_0.y));
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;

exports[`Beam (b) preconverted color path (non-linear space) > reads the convA/convB extraFields and mixes in-space via mixPreconverted > final-pass-oklch 1`] = `
"fn geom_aspectOf(viewport: vec2f) -> f32 {
  return (viewport.x / max(viewport.y, 1e-6f));
}

fn lightfields_pointToSegment(p: vec2f, a: vec2f, b: vec2f) -> vec2f {
  let lineVec = vec2f((b.x - a.x), (b.y - a.y));
  let toPoint = vec2f((p.x - a.x), (p.y - a.y));
  let dotProduct = ((toPoint.x * lineVec.x) + (toPoint.y * lineVec.y));
  let lineLengthSq = ((lineVec.x * lineVec.x) + (lineVec.y * lineVec.y));
  let t = clamp((dotProduct / max(lineLengthSq, 1e-4f)), 0f, 1f);
  let closestPoint = vec2f((a.x + (lineVec.x * t)), (a.y + (lineVec.y * t)));
  let distVec = vec2f((p.x - closestPoint.x), (p.y - closestPoint.y));
  return vec2f(t, sqrt(((distVec.x * distVec.x) + (distVec.y * distVec.y))));
}

fn lightfields_taperedSegmentGlow(dist: f32, t: f32, startThickness: f32, endThickness: f32, startSoftness: f32, endSoftness: f32) -> vec2f {
  let thickness = mix(startThickness, endThickness, t);
  let softness = max(mix(startSoftness, endSoftness, t), 1e-4f);
  let normalizedDist = (dist / max(thickness, 1e-4f));
  let edgeEnd = (1f + softness);
  let alphaBase = (1f - smoothstep(1f, edgeEnd, normalizedDist));
  let softnessFactor = (1f + (softness * 1.5f));
  let alpha = pow(alphaBase, softnessFactor);
  let colorGradientStart = (1f - softness);
  let colorGradientEnd = (1f + softness);
  let colorT = smoothstep(colorGradientStart, colorGradientEnd, normalizedDist);
  return vec2f(colorT, alpha);
}

fn beamField(uv: vec2f, vp: vec2f, start: vec2f, end: vec2f, startThickness: f32, endThickness: f32, startSoftness: f32, endSoftness: f32) -> vec2f {
  let aspect = geom_aspectOf(vp);
  let startPos = vec2f(start.x, (1f - start.y));
  let endPos = vec2f(end.x, (1f - end.y));
  let acStart = vec2f((startPos.x * aspect), startPos.y);
  let acEnd = vec2f((endPos.x * aspect), endPos.y);
  let acUV = vec2f((uv.x * aspect), uv.y);
  let proj = lightfields_pointToSegment(acUV, acStart, acEnd);
  let field = lightfields_taperedSegmentGlow(proj.y, proj.x, (startThickness * 0.25f), (endThickness * 0.25f), startSoftness, endSoftness);
  let colorT = field.x;
  let alpha = field.y;
  return vec2f(colorT, alpha);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  startPosition: vec2f,
  endPosition: vec2f,
  startThickness: f32,
  endThickness: f32,
  startSoftness: f32,
  endSoftness: f32,
  insideColor: vec4f,
  outsideColor: vec4f,
  colorSpace: f32,
  _opacity: f32,
  convA: vec3f,
  convB: vec3f,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_beam: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn mixHueShortest(hA: f32, cA: f32, hB: f32, cB: f32, wB: f32, sw: f32, achromatic: f32) -> f32 {
  let hueA = select(hA, hB, (cA < achromatic));
  let hueB = select(hB, hueA, (cB < achromatic));
  let diff = (hueB - hueA);
  let wrapped = (diff - (floor(((diff + 3.14159265359f) * 0.15915494309f)) * 6.28318530718f));
  return (hueA + (wrapped * (wB / sw)));
}

fn awMixOklch(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  let m = awMix(a, b, wA, wB, sw);
  return vec3f(m.x, m.y, mixHueShortest(a.z, a.y, b.z, b.y, wB, sw, 1e-3f));
}

fn oklchToOklab(lch: vec3f) -> vec3f {
  let L = lch.x;
  let C = lch.y;
  let h = lch.z;
  return vec3f(L, (C * cos(h)), (C * sin(h)));
}

fn oklabToRgb(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let l_ = ((L + (a * 0.3963377774f)) + (b * 0.2158037573f));
  let m_ = ((L - (a * 0.1055613458f)) - (b * 0.0638541728f));
  let s_ = ((L - (a * 0.0894841775f)) - (b * 1.291485548f));
  let l = pow(l_, 3f);
  let m = pow(m_, 3f);
  let s = pow(s_, 3f);
  return vec3f((((l * 4.0767416621f) - (m * 3.3077115913f)) + (s * 0.2309699292f)), (((l * -1.2684380046f) + (m * 2.6097574011f)) - (s * 0.3413193965f)), (((l * -0.0041960863f) - (m * 0.7034186147f)) + (s * 1.707614701f)));
}

fn sRGBToP3(srgb: vec3f) -> vec3f {
  let r = (((srgb.x * 0.8224621f) + (srgb.y * 0.177538f)) + (srgb.z * 0f));
  let g = (((srgb.x * 0.0331941f) + (srgb.y * 0.9668058f)) + (srgb.z * 0f));
  let b = (((srgb.x * 0.0170826f) + (srgb.y * 0.0723974f)) + (srgb.z * 0.9105199f));
  return vec3f(r, g, b);
}

fn mixPreconvertedColors(convA: vec3f, convB: vec3f, alphaA: f32, alphaB: f32, t: f32) -> vec4f {
  let weightA = (alphaA * (1f - t));
  let weightB = (alphaB * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let mixed = awMixOklch(convA, convB, weightA, weightB, safeWeight);
  return vec4f(sRGBToP3(oklabToRgb(oklchToOklab(mixed))), totalWeight);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let beamField_0 = beamField(uv, uniforms._sys.viewportSize, uniforms.n_beam.startPosition, uniforms.n_beam.endPosition, uniforms.n_beam.startThickness, uniforms.n_beam.endThickness, uniforms.n_beam.startSoftness, uniforms.n_beam.endSoftness);
  var composed_1 = vec4f((mixPreconvertedColors(uniforms.n_beam.convA, uniforms.n_beam.convB, uniforms.n_beam.insideColor.a, uniforms.n_beam.outsideColor.a, beamField_0.x)).rgb, (((uniforms.n_beam.insideColor.a + uniforms.n_beam.outsideColor.a) * 0.5) * beamField_0.y));
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;
