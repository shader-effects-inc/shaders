@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 64>;

@group(0) @binding(3) var<storage, read_write> dyeB: array<vec4f, 64>;

fn gateTAdvectDens(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 8u) + cx);
  let vel = (&velA[idx]);
  let srcX = (((f32(cx) - ((*vel).x * (*p).dt)) + 8f) % 8f);
