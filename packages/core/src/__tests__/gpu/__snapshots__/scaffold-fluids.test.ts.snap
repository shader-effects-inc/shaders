@group(0) @binding(6) var<uniform> params: Params;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

@group(0) @binding(1) var<storage, read_write> velB: array<vec4f, 64>;

fn gateTAdvectVel(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 8u) + cx);
  let vel = (&velA[idx]);
  let srcX = (((f32(cx) - ((*vel).x * (*p).dt)) + 8f) % 8f);
  let srcY = (((f32(cy) - ((*vel).y * (*p).dt)) + 8f) % 8f);
