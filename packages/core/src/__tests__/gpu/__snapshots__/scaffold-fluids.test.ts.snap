@group(0) @binding(4) var<storage, read_write> pressure: array<f32, 64>;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn gateTGradSubtract(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let pL = pressure[nw(ii, ji, 0i, -1i)];
  let pR = pressure[nw(ii, ji, 0i, 1i)];
  let pU = pressure[nw(ii, ji, -1i, 0i)];
  let pD = pressure[nw(ii, ji, 1i, 0i)];
  let vel = (&velA[idx]);
  let vx = ((*vel).x - ((pR - pL) * 0.5f));
  let vy = ((*vel).y - ((pD - pU) * 0.5f));
  const maxVel = 4.800000190734863f;
  let vLen = max(sqrt(((vx * vx) + (vy * vy))), 9.999999974752427e-7f);
  let capScale = (maxVel / max(vLen, maxVel));
  velA[idx] = vec4f((vx * capScale), (vy * capScale), (*vel).z, 0f);
}
struct Params {
  dt: f32,
  curlStrength: f32,
  velFade: f32,
  dyeFade: f32,
  colorDecay: f32,
