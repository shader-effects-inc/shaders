@group(0) @binding(5) var<uniform> params: SimParams;

fn floatBitsToUint3(v: vec3f) -> vec3u { return bitcast<vec3u>(v); }

fn hash33(p: vec3f) -> vec3f {
  let u = floatBitsToUint3((p * vec3f(141421360, 2718281728, 1618034048)));
  let h = ((u.x ^ u.y) ^ u.z);
  let prod = (vec3u(h, h, h) * vec3u(1732050807, 2645751311, 3316624790));
  return (vec3f(f32(prod.x), f32(prod.y), f32(prod.z)) / 4294967296f);
}

@group(0) @binding(0) var<storage, read_write> agents: array<vec4f, 16384>;

fn particleFlowInit(i: u32) {
  let prm = (&params);
  let fi = f32(i);
  let r = hash33(vec3f(((fi * 1.6180339f) + 0.71f), ((fi * 2.7182818f) + 4.17f), ((fi * 3.1415926f) + 9.03f)));
  agents[i] = vec4f((r.x * (*prm).aspect), r.y, 0f, 0f);
}
struct SimParams {
  colA: vec4f,
  colB: vec4f,
  dt: f32,
  aspect: f32,
  trails: f32,
  bodyR: f32,
