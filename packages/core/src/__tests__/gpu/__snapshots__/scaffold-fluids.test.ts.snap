exports[`fluids scaffold (a) kernel sets resolve per configuration > clamped + densityAge: every pass resolves with the consumer name prefix > clamped-densityAge 1`] = `
"fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn gateACurl(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let vL = (&velA[nidx(ii, ji, 0i, -1i)]);
  let vR = (&velA[nidx(ii, ji, 0i, 1i)]);
  let vU = (&velA[nidx(ii, ji, -1i, 0i)]);
  let vD = (&velA[nidx(ii, ji, 1i, 0i)]);
  let curlZ = ((((*vR).y - (*vL).y) - ((*vD).x - (*vU).x)) * 0.5f);
  let vel = (&velA[idx]);
  velA[idx] = vec4f((*vel).x, (*vel).y, curlZ, 0f);
}
struct Params {
  dt: f32,
  curlStrength: f32,
  velFade: f32,
  dyeFade: f32,
  colorDecay: f32,
}

@group(0) @binding(6) var<uniform> params: Params;

fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn gateAVorticity(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let cL = abs(velA[nidx(ii, ji, 0i, -1i)].z);
  let cR = abs(velA[nidx(ii, ji, 0i, 1i)].z);
  let cU = abs(velA[nidx(ii, ji, -1i, 0i)].z);
  let cD = abs(velA[nidx(ii, ji, 1i, 0i)].z);
  let cc = velA[idx].z;
  let gx = ((cR - cL) * 0.5f);
  let gy = ((cD - cU) * 0.5f);
  let gl = max(sqrt(((gx * gx) + (gy * gy))), 9.999999747378752e-6f);
  let fx = ((((gy / gl) * cc) * (*p).curlStrength) * (*p).dt);
  let fy = (((((gx / gl) * -1f) * cc) * (*p).curlStrength) * (*p).dt);
  let vel = (&velA[idx]);
  velA[idx] = vec4f(((*vel).x + fx), ((*vel).y + fy), (*vel).z, 0f);
}
@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(4) var<storage, read_write> pressure: array<f32, 64>;

@group(0) @binding(5) var<storage, read_write> divergence: array<f32, 64>;

fn gateADivergence(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let jf = f32(cx);
  let iF = f32(cy);
  let selfVel = (&velA[idx]);
  let normalL = velA[nidx(ii, ji, 0i, -1i)].x;
  let normalR = velA[nidx(ii, ji, 0i, 1i)].x;
  let normalU = velA[nidx(ii, ji, -1i, 0i)].y;
  let normalD = velA[nidx(ii, ji, 1i, 0i)].y;
  let L = select(normalL, ((*selfVel).x * -1f), (jf < 0.5f));
  let R = select(normalR, ((*selfVel).x * -1f), (jf > 6.5f));
  let T = select(normalU, ((*selfVel).y * -1f), (iF < 0.5f));
  let B = select(normalD, ((*selfVel).y * -1f), (iF > 6.5f));
  let div = (((R - L) + (B - T)) * 0.5f);
  pressure[idx] = (pressure[idx] * 0.8f);
  divergence[idx] = div;
}
fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(4) var<storage, read_write> pressure: array<f32, 64>;

@group(0) @binding(5) var<storage, read_write> divergence: array<f32, 64>;

fn gateAJacobi(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let pL = pressure[nidx(ii, ji, 0i, -1i)];
  let pR = pressure[nidx(ii, ji, 0i, 1i)];
  let pU = pressure[nidx(ii, ji, -1i, 0i)];
  let pD = pressure[nidx(ii, ji, 1i, 0i)];
  let div = divergence[idx];
  pressure[idx] = (((((pL + pR) + pU) + pD) - div) * 0.25f);
}
fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(4) var<storage, read_write> pressure: array<f32, 64>;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn gateAGradSubtract(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let pL = pressure[nidx(ii, ji, 0i, -1i)];
  let pR = pressure[nidx(ii, ji, 0i, 1i)];
  let pU = pressure[nidx(ii, ji, -1i, 0i)];
  let pD = pressure[nidx(ii, ji, 1i, 0i)];
  let vel = (&velA[idx]);
  velA[idx] = vec4f(((*vel).x - ((pR - pL) * 0.5f)), ((*vel).y - ((pD - pU) * 0.5f)), (*vel).z, 0f);
}
struct Params {
  dt: f32,
  curlStrength: f32,
  velFade: f32,
  dyeFade: f32,
  colorDecay: f32,
}

@group(0) @binding(6) var<uniform> params: Params;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

@group(0) @binding(1) var<storage, read_write> velB: array<vec4f, 64>;

fn gateAAdvectVel(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 8u) + cx);
  let vel = (&velA[idx]);
  let srcX = clamp((f32(cx) - ((*vel).x * (*p).dt)), 0f, 7f);
  let srcY = clamp((f32(cy) - ((*vel).y * (*p).dt)), 0f, 7f);
  let x0 = clamp(floor(srcX), 0f, 6f);
  let y0 = clamp(floor(srcY), 0f, 6f);
  let sx = (srcX - x0);
  let sy = (srcY - y0);
  let ix0 = i32(x0);
  let iy0 = i32(y0);
  let v00 = (&velA[u32(((iy0 * 8i) + ix0))]);
  let v10 = (&velA[u32((((iy0 * 8i) + ix0) + 1i))]);
  let v01 = (&velA[u32((((iy0 + 1i) * 8i) + ix0))]);
  let v11 = (&velA[u32(((((iy0 + 1i) * 8i) + ix0) + 1i))]);
  let decay = (1f + ((*p).velFade * (*p).dt));
  velB[idx] = vec4f((mix(mix((*v00).x, (*v10).x, sx), mix((*v01).x, (*v11).x, sx), sy) / decay), (mix(mix((*v00).y, (*v10).y, sx), mix((*v01).y, (*v11).y, sx), sy) / decay), 0f, 0f);
}
@group(0) @binding(1) var<storage, read_write> velB: array<vec4f, 64>;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn gateACopyVel(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let v = (&velB[idx]);
  velA[idx] = vec4f((*v).x, (*v).y, 0f, 0f);
}
struct Params {
  dt: f32,
  curlStrength: f32,
  velFade: f32,
  dyeFade: f32,
  colorDecay: f32,
}

@group(0) @binding(6) var<uniform> params: Params;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 64>;

@group(0) @binding(3) var<storage, read_write> dyeB: array<vec4f, 64>;

fn gateAAdvectDens(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 8u) + cx);
  let vel = (&velA[idx]);
  let srcX = clamp((f32(cx) - ((*vel).x * (*p).dt)), 0f, 7f);
  let srcY = clamp((f32(cy) - ((*vel).y * (*p).dt)), 0f, 7f);
  let x0 = clamp(floor(srcX), 0f, 6f);
  let y0 = clamp(floor(srcY), 0f, 6f);
  let sx = (srcX - x0);
  let sy = (srcY - y0);
  let ix0 = i32(x0);
  let iy0 = i32(y0);
  let d00 = (&dyeA[u32(((iy0 * 8i) + ix0))]);
  let d10 = (&dyeA[u32((((iy0 * 8i) + ix0) + 1i))]);
  let d01 = (&dyeA[u32((((iy0 + 1i) * 8i) + ix0))]);
  let d11 = (&dyeA[u32(((((iy0 + 1i) * 8i) + ix0) + 1i))]);
  let dens = mix(mix((*d00).x, (*d10).x, sx), mix((*d01).x, (*d11).x, sx), sy);
  let age = mix(mix((*d00).y, (*d10).y, sx), mix((*d01).y, (*d11).y, sx), sy);
  let decay = (1f + ((*p).dyeFade * (*p).dt));
  dyeB[idx] = vec4f(max((dens / decay), 0f), min((age + (((*p).dt * 0.4f) * (*p).colorDecay)), 1f), 0f, 0f);
}
@group(0) @binding(3) var<storage, read_write> dyeB: array<vec4f, 64>;

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 64>;

fn gateACopyDens(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let dd = (&dyeB[idx]);
  dyeA[idx] = vec4f((*dd).x, (*dd).y, 0f, 0f);
}"
`;

exports[`fluids scaffold (a) kernel sets resolve per configuration > solidMask turns mask cells into walls in the divergence pass > masked-divergence 1`] = `
"@group(0) @binding(6) var<storage, read> maskBuf: array<vec4f, 64>;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 64>;

fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 7i);
  let col = clamp((ji + dj), 0i, 7i);
  return u32(((row * 8i) + col));
}

@group(0) @binding(4) var<storage, read_write> pressure: array<f32, 64>;

@group(0) @binding(5) var<storage, read_write> divergence: array<f32, 64>;

fn gateMaskDivergence(cx: u32, cy: u32) {
  let idx = ((cy * 8u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let jf = f32(cx);
  let iF = f32(cy);
  let selfMask = maskBuf[idx].x;
  let selfVel = (&velA[idx]);
  let isWallL = ((jf < 0.5f) || (maskBuf[nidx(ii, ji, 0i, -1i)].x < 0.5f));
  let isWallR = ((jf > 6.5f) || (maskBuf[nidx(ii, ji, 0i, 1i)].x < 0.5f));
  let isWallT = ((iF < 0.5f) || (maskBuf[nidx(ii, ji, -1i, 0i)].x < 0.5f));
  let isWallB = ((iF > 6.5f) || (maskBuf[nidx(ii, ji, 1i, 0i)].x < 0.5f));
  let L = select(velA[nidx(ii, ji, 0i, -1i)].x, ((*selfVel).x * -1f), isWallL);
  let R = select(velA[nidx(ii, ji, 0i, 1i)].x, ((*selfVel).x * -1f), isWallR);
  let T = select(velA[nidx(ii, ji, -1i, 0i)].y, ((*selfVel).y * -1f), isWallT);
  let B = select(velA[nidx(ii, ji, 1i, 0i)].y, ((*selfVel).y * -1f), isWallB);
  let div = ((((R - L) + (B - T)) * 0.5f) * selfMask);
  pressure[idx] = ((pressure[idx] * 0.8f) * selfMask);
  divergence[idx] = div;
}"
`;

