@group(0) @binding(6) var<uniform> params: FlowParams;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 65536>;

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 65536>;

@group(0) @binding(3) var<storage, read_write> dyeB: array<vec4f, 65536>;

fn smokeFlowAdvectDens(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 256u) + cx);
  let vel = (&velA[idx]);
  let srcX = clamp((f32(cx) - ((*vel).x * (*p).dt)), 0f, 255f);
  let srcY = clamp((f32(cy) - ((*vel).y * (*p).dt)), 0f, 255f);
  let x0 = clamp(floor(srcX), 0f, 254f);
  let y0 = clamp(floor(srcY), 0f, 254f);
  let sx = (srcX - x0);
  let sy = (srcY - y0);
  let ix0 = i32(x0);
  let iy0 = i32(y0);
  let d00 = (&dyeA[u32(((iy0 * 256i) + ix0))]);
  let d10 = (&dyeA[u32((((iy0 * 256i) + ix0) + 1i))]);
  let d01 = (&dyeA[u32((((iy0 + 1i) * 256i) + ix0))]);
  let d11 = (&dyeA[u32(((((iy0 + 1i) * 256i) + ix0) + 1i))]);
  let dens = mix(mix((*d00).x, (*d10).x, sx), mix((*d01).x, (*d11).x, sx), sy);
  let age = mix(mix((*d00).y, (*d10).y, sx), mix((*d01).y, (*d11).y, sx), sy);
  let decay = (1f + ((*p).dyeFade * (*p).dt));
  dyeB[idx] = vec4f(max((dens / decay), 0f), min((age + (((*p).dt * 0.4f) * (*p).colorDecay)), 1f), 0f, 0f);
}
@group(0) @binding(3) var<storage, read_write> dyeB: array<vec4f, 65536>;

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 65536>;

fn smokeFlowCopyDens(cx: u32, cy: u32) {
  let idx = ((cy * 256u) + cx);
  let dd = (&dyeB[idx]);
  dyeA[idx] = vec4f((*dd).x, (*dd).y, 0f, 0f);
}
@group(0) @binding(0) var<storage, read> dyeA: array<vec4f, 65536>;

@group(0) @binding(1) var outTex: texture_storage_2d<rgba16float, write>;

fn smokeFlowOutput(cx: u32, cy: u32) {
  let idx = ((cy * 256u) + cx);
  let dd = (&dyeA[idx]);
  textureStore(outTex, vec2u(cx, cy), vec4f((*dd).x, (*dd).y, 0f, 0f));
}"
`;
