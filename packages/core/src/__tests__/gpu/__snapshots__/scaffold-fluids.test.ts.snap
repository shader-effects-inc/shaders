  let iy0 = i32(y0);
  let ix1 = ((ix0 + 1i) % 8i);
  let iy1 = ((iy0 + 1i) % 8i);
  let v00 = (&velA[u32(((iy0 * 8i) + ix0))]);
  let v10 = (&velA[u32(((iy0 * 8i) + ix1))]);
  let v01 = (&velA[u32(((iy1 * 8i) + ix0))]);
  let v11 = (&velA[u32(((iy1 * 8i) + ix1))]);
  let decay = (1f + ((*p).velFade * (*p).dt));
  velB[idx] = vec4f((mix(mix((*v00).x, (*v10).x, sx), mix((*v01).x, (*v11).x, sx), sy) / decay), (mix(mix((*v00).y, (*v10).y, sx), mix((*v01).y, (*v11).y, sx), sy) / decay), 0f, 0f);
