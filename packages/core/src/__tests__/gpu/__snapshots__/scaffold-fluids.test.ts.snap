  let f = (p - i);
  let u = (((f * f) * f) * ((f * ((f * 6f) - 15f)) + 10f));
  let a0 = perlinGrad3(i, f, 0f, 0f, 0f);
  let b0 = perlinGrad3(i, f, 1f, 0f, 0f);
  let c0 = perlinGrad3(i, f, 0f, 1f, 0f);
  let d0 = perlinGrad3(i, f, 1f, 1f, 0f);
  let a1 = perlinGrad3(i, f, 0f, 0f, 1f);
  let b1 = perlinGrad3(i, f, 1f, 0f, 1f);
  let c1 = perlinGrad3(i, f, 0f, 1f, 1f);
  let d1 = perlinGrad3(i, f, 1f, 1f, 1f);
  let z0 = mix(mix(a0, b0, u.x), mix(c0, d0, u.x), u.y);
  let z1 = mix(mix(a1, b1, u.x), mix(c1, d1, u.x), u.y);
  return ((mix(z0, z1, u.z) * 0.7f) + 0.5f);
}

fn noise_curl22z(p: vec2f, z: f32) -> vec2f {
  let pax = (p + vec2f(0.10000000149011612, 0));
  let pay = (p + vec2f(0, 0.10000000149011612));
  let pbx = (p - vec2f(0.10000000149011612, 0));
  let pby = (p - vec2f(0, 0.10000000149011612));
  let a = vec2f(perlin13(vec3f(pax.x, pax.y, z)), perlin13(vec3f(pay.x, pay.y, z)));
  let b = vec2f(perlin13(vec3f(pbx.x, pbx.y, z)), perlin13(vec3f(pby.x, pby.y, z)));
  return (((a - b) / 0.1f) * 0.5f);
}

fn particleFlowVorticity(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 256u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let cL = abs(velA[nidx(ii, ji, 0i, -1i)].z);
  let cR = abs(velA[nidx(ii, ji, 0i, 1i)].z);
  let cU = abs(velA[nidx(ii, ji, -1i, 0i)].z);
  let cD = abs(velA[nidx(ii, ji, 1i, 0i)].z);
  let cc = velA[idx].z;
  let gx = ((cR - cL) * 0.5f);
  let gy = ((cD - cU) * 0.5f);
  let gl = max(sqrt(((gx * gx) + (gy * gy))), 9.999999747378752e-6f);
  let fx = ((((gy / gl) * cc) * (*p).curlStrength) * (*p).dt);
  let fy = (((((gx / gl) * -1f) * cc) * (*p).curlStrength) * (*p).dt);
  var ax = 0f;
  var ay = 0f;
  if (((*p).ambient > 0f)) {
    let uvx = ((f32(cx) + 0.5f) / 256f);
    let uvy = ((f32(cy) + 0.5f) / 256f);
    let amb = noise_curl22z(vec2f((uvx * (*p).ambientFreq), (uvy * (*p).ambientFreq)), (*p).ambientTime);
    let af = (((*p).ambient * 26f) * (*p).dt);
    ax = (amb.x * af);
    ay = (amb.y * af);
  }
  let vel = (&velA[idx]);
  velA[idx] = vec4f((((*vel).x + fx) + ax), (((*vel).y + fy) + ay), (*vel).z, 0f);
}
struct SimParams {
  colA: vec4f,
  colB: vec4f,
  dt: f32,
  aspect: f32,
  trails: f32,
  bodyR: f32,
  speedNorm: f32,
  advect: f32,
