  advect: f32,
}

@group(0) @binding(5) var<uniform> params: SimParams;

@group(0) @binding(0) var<storage, read_write> agents: array<vec4f, 16384>;

struct AgentBilinearFrame {
  x0: u32,
  x1: u32,
  y0: u32,
  y1: u32,
  fx: f32,
  fy: f32,
}

fn agentBilinearTexelFrame(uv01: vec2f, dims: vec2f) -> AgentBilinearFrame {
  let cu = ((uv01.x * dims.x) - 0.5f);
  let cv = ((uv01.y * dims.y) - 0.5f);
  let cx0 = floor(cu);
  let cy0 = floor(cv);
  return AgentBilinearFrame(u32(clamp(cx0, 0f, (dims.x - 1f))), u32(clamp((cx0 + 1f), 0f, (dims.x - 1f))), u32(clamp(cy0, 0f, (dims.y - 1f))), u32(clamp((cy0 + 1f), 0f, (dims.y - 1f))), (cu - cx0), (cv - cy0));
}

@group(0) @binding(4) var velTex: texture_2d<f32>;

fn particleFlowIntegrate(i: u32) {
  let prm = (&params);
  let a = (&agents[i]);
  let pos = vec2f((*a).x, (*a).y);
  let dt = (*prm).dt;
  let aspect = max((*prm).aspect, 1e-5f);
  const NF = 256f;
  let bf = agentBilinearTexelFrame(vec2f((pos.x / aspect), pos.y), vec2f(NF, NF));
  let v00 = textureLoad(velTex, vec2u(bf.x0, bf.y0), 0);
  let v10 = textureLoad(velTex, vec2u(bf.x1, bf.y0), 0);
  let v01 = textureLoad(velTex, vec2u(bf.x0, bf.y1), 0);
  let v11 = textureLoad(velTex, vec2u(bf.x1, bf.y1), 0);
  let gvx = mix(mix(v00.x, v10.x, bf.fx), mix(v01.x, v11.x, bf.fx), bf.fy);
  let gvy = mix(mix(v00.y, v10.y, bf.fx), mix(v01.y, v11.y, bf.fx), bf.fy);
  let fieldVx = (((gvx / NF) * aspect) * (*prm).advect);
  let fieldVy = ((gvy / NF) * (*prm).advect);
  let blend = (1f - exp(((dt * 6f) * -1f)));
  let fi = f32(i);
  let homeX = (fract((0.5f + (fi * 0.7548776662466927f))) * aspect);
  let homeY = fract((0.5f + (fi * 0.5698402909980532f)));
  let velX = (mix((*a).z, fieldVx, blend) + ((homeX - pos.x) * (1.8f * dt)));
  let velY = (mix((*a).w, fieldVy, blend) + ((homeY - pos.y) * (1.8f * dt)));
  let nposX = clamp((pos.x + (velX * dt)), 0f, aspect);
  let nposY = clamp((pos.y + (velY * dt)), 0f, 1f);
  agents[i] = vec4f(nposX, nposY, velX, velY);
}
struct SimParams {
  colA: vec4f,
  colB: vec4f,
  dt: f32,
  aspect: f32,
  trails: f32,
  bodyR: f32,
  speedNorm: f32,
  advect: f32,
}

@group(0) @binding(5) var<uniform> params: SimParams;

@group(0) @binding(0) var<storage, read_write> agents: array<vec4f, 16384>;

struct AgentPose {
  pos: vec2f,
  dir: vec2f,
  spd: f32,
}

fn particleFlowSplatPose(i: u32) -> AgentPose {
  let a = (&agents[i]);
  let vel = vec2f((*a).z, (*a).w);
  let spd = length(vel);
  return AgentPose(vec2f((*a).x, (*a).y), select(vec2f(1, 0), (vel / max(spd, 1e-5f)), (spd > 1e-5f)), spd);
}

fn particleFlowSplatExcitement(_i: u32, spd: f32) -> f32 {
  return clamp((spd / max(params.speedNorm, 1e-5f)), 0f, 1f);
}

struct SplatWindow {
  x0: i32,
  x1: i32,
  y0: i32,
  y1: i32,
}

fn worldSplatWindow(pos: vec2f, reach: f32, aspect: f32, res: f32) -> SplatWindow {
  let asp = max(aspect, 1e-5f);
  let cxi = i32(floor(((pos.x / asp) * res)));
  let cyi = i32(floor((pos.y * res)));
  let radX = i32(ceil(((reach * res) / asp)));
  let radY = i32(ceil((reach * res)));
  let last = (i32(res) - 1i);
  return SplatWindow(max((cxi - radX), 0i), min((cxi + radX), last), max((cyi - radY), 0i), min((cyi + radY), last));
}

fn agentCapsuleSdf(t: f32, n: f32, hl: f32, r: f32) -> f32 {
  let tc = (t - clamp(t, -(hl), hl));
  return (sqrt(((tc * tc) + (n * n))) - r);
}

fn agentTexelWeight(_q: f32, t: f32, n: f32, bodyR: f32, aaW: f32) -> f32 {
  let sd = agentCapsuleSdf(t, n, (bodyR * 1.7f), (bodyR * 0.8f));
  return (1f - smoothstep(-(aaW), aaW, sd));
}

fn agentCometWeight(t: f32, n: f32, bodyR: f32, aaW: f32) -> f32 {
  let hl = (bodyR * 1.7f);
  let tGlow = (t - clamp(t, -(hl), hl));
  let tEval = select(t, tGlow, false);
  let tk = clamp(((hl - t) / max((hl * 2f), 1e-6f)), 0f, 1f);
  let bright = (1f - ((0.55f * tk) * 0f));
  let qEval = (((tEval * tEval) + (n * n)) / (bodyR * bodyR));
  return (agentTexelWeight(qEval, tEval, n, bodyR, aaW) * bright);
}

fn particleFlowSplatWeight(_dSq: f32, offX: f32, offY: f32, dir: vec2f, bodyR: f32, _bodyRSq: f32, aaW: f32) -> f32 {
  let t = ((offX * dir.x) + (offY * dir.y));
  let n = ((offX * -(dir.y)) + (offY * dir.x));
  return agentCometWeight(t, n, bodyR, aaW);
}

@group(0) @binding(1) var<storage, read_write> accumE: array<atomic<u32>, 1048576>;

@group(0) @binding(2) var<storage, read_write> accumS: array<atomic<u32>, 1048576>;

fn particleFlowSplat(i: u32) {
  let prm = (&params);
  let p = particleFlowSplatPose(i);
  let agitI = particleFlowSplatExcitement(i, p.spd);
  let agitGain = (agitI * 637f);
  let aspect = max((*prm).aspect, 1e-5f);
  let bodyR = clamp((*prm).bodyR, 1e-6f, 0.013671875f);
  let bodyRSq = (bodyR * bodyR);
  let radW = ((bodyR * 2.6f) + 0.00146484375f);
  let extSq = (radW * radW);
  let win = worldSplatWindow(p.pos, radW, aspect, 1024f);
  for (var py = win.y0; (py <= win.y1); py++) {
    let offY = (((f32(py) + 0.5f) * 9.765625e-4f) - p.pos.y);
    let offYSq = (offY * offY);
    for (var px = win.x0; (px <= win.x1); px++) {
      let offX = ((((f32(px) + 0.5f) * 9.765625e-4f) * aspect) - p.pos.x);
      let dSq = ((offX * offX) + offYSq);
      if ((dSq < extSq)) {
        let w = particleFlowSplatWeight(dSq, offX, offY, p.dir, bodyR, bodyRSq, 7.32421875e-4f);
        let e = u32((w * 637f));
        if ((e > 0u)) {
          let idx = u32(((py * 1024i) + px));
          atomicAdd(&accumE[idx], e);
          if ((agitI > 0f)) {
            atomicAdd(&accumS[idx], u32((w * agitGain)));
          }
        }
      }
    }
  }
}
struct SimParams {
  colA: vec4f,
  colB: vec4f,
  dt: f32,
  aspect: f32,
  trails: f32,
  bodyR: f32,
  speedNorm: f32,
  advect: f32,
}

@group(0) @binding(5) var<uniform> params: SimParams;

@group(0) @binding(1) var<storage, read_write> accumE: array<atomic<u32>, 1048576>;

@group(0) @binding(2) var<storage, read_write> accumS: array<atomic<u32>, 1048576>;

fn particleFlowResolveEnergy(eRaw: f32) -> f32 {
  return (eRaw * 0.00392156862745098f);
}

fn p3ToSRGB(p3: vec3f) -> vec3f {
  let r = (((p3.x * 1.2249401f) - (p3.y * 0.2249404f)) - (p3.z * 0f));
  let g = (((p3.x * -0.0420569f) + (p3.y * 1.0420571f)) + (p3.z * 0f));
  let b = (((p3.x * -0.0196376f) - (p3.y * 0.0786361f)) + (p3.z * 1.0982735f));
  return vec3f(r, g, b);
}

fn rgbToOklab(rgb: vec3f) -> vec3f {
  let r = rgb.x;
  let g = rgb.y;
  let b = rgb.z;
  let l = (((r * 0.4122214708f) + (g * 0.5363325363f)) + (b * 0.0514459929f));
  let m = ((r * 0.2119034982f) + ((g * 0.6806995451f) + (b * 0.1073969566f)));
  let s = (((r * 0.0883024619f) + (g * 0.2817188376f)) + (b * 0.6299787005f));
  let l_ = (sign(l) * pow(abs(l), 0.3333333333333333f));
  let m_ = (sign(m) * pow(abs(m), 0.3333333333333333f));
  let s_ = (sign(s) * pow(abs(s), 0.3333333333333333f));
  return vec3f((((l_ * 0.2104542553f) + (m_ * 0.793617785f)) - (s_ * 0.0040720468f)), (((l_ * 1.9779984951f) - (m_ * 2.428592205f)) + (s_ * 0.4505937099f)), (((l_ * 0.0259040371f) + (m_ * 0.7827717662f)) - (s_ * 0.808675766f)));
}

fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn oklabToRgb(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let l_ = ((L + (a * 0.3963377774f)) + (b * 0.2158037573f));
  let m_ = ((L - (a * 0.1055613458f)) - (b * 0.0638541728f));
  let s_ = ((L - (a * 0.0894841775f)) - (b * 1.291485548f));
  let l = pow(l_, 3f);
  let m = pow(m_, 3f);
  let s = pow(s_, 3f);
  return vec3f((((l * 4.0767416621f) - (m * 3.3077115913f)) + (s * 0.2309699292f)), (((l * -1.2684380046f) + (m * 2.6097574011f)) - (s * 0.3413193965f)), (((l * -0.0041960863f) - (m * 0.7034186147f)) + (s * 1.707614701f)));
}

fn sRGBToP3(srgb: vec3f) -> vec3f {
  let r = (((srgb.x * 0.8224621f) + (srgb.y * 0.177538f)) + (srgb.z * 0f));
  let g = (((srgb.x * 0.0331941f) + (srgb.y * 0.9668058f)) + (srgb.z * 0f));
  let b = (((srgb.x * 0.0170826f) + (srgb.y * 0.0723974f)) + (srgb.z * 0.9105199f));
  return vec3f(r, g, b);
}

fn mixFn(colorA: vec4f, colorB: vec4f, t: f32) -> vec4f {
  let weightA = (colorA.w * (1f - t));
  let weightB = (colorB.w * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let oklabA = rgbToOklab(p3ToSRGB(colorA.xyz));
  let oklabB = rgbToOklab(p3ToSRGB(colorB.xyz));
  let mixed = awMix(oklabA, oklabB, weightA, weightB, safeWeight);
  let rgb = sRGBToP3(oklabToRgb(mixed));
  return vec4f(rgb, totalWeight);
}

fn energyCoverageAlpha(energy: f32, k: f32) -> f32 {
  return (1f - exp(((energy * k) * -1f)));
}

fn particleFlowResolveTrailComposite(col: vec4f, curA: f32, _idx: u32) -> vec4f {
  return vec4f(col.x, col.y, col.z, curA);
}

@group(0) @binding(3) var<storage, read_write> trailBuf: array<vec4f, 1048576>;

@group(0) @binding(6) var outTex: texture_storage_2d<rgba16float, write>;

fn particleFlowResolve(x: u32, y: u32) {
  let prm = (&params);
  let idx = ((y * 1024u) + x);
  let eRaw = f32(atomicLoad(&accumE[idx]));
  atomicStore(&accumE[idx], 0u);
  let sRaw = f32(atomicLoad(&accumS[idx]));
  atomicStore(&accumS[idx], 0u);
  let energy = particleFlowResolveEnergy(eRaw);
  var col = (*prm).colA;
  if ((eRaw > 0f)) {
    let agitAvg = (sRaw / max(eRaw, 1f));
    col = mixFn((*prm).colA, (*prm).colB, clamp(agitAvg, 0f, 1f));
  }
  let curA = (energyCoverageAlpha(energy, 1.6f) * col.w);
  let out = particleFlowResolveTrailComposite(col, curA, idx);
  trailBuf[idx] = out;
  textureStore(outTex, vec2u(x, y), out);
}"
`;

exports[`fluids scaffold (b) the six consumers > Smoke resolves its whole solver chain > Smoke-kernels 1`] = `
"struct FluidParams {
  dt: f32,
  emitX: f32,
  emitY: f32,
  emitVelX: f32,
  emitVelY: f32,
  perpDirX: f32,
  perpDirY: f32,
  spreadFactor: f32,
  emitRad: f32,
  emitIntensity: f32,
  dyeFade: f32,
  velFade: f32,
  curlStrength: f32,
  gravity: f32,
  cursorX: f32,
  cursorY: f32,
  cursorVelX: f32,
  cursorVelY: f32,
  mouseActive: f32,
  mouseRadSq: f32,
  colorDecay: f32,
}

@group(0) @binding(6) var<uniform> params: FluidParams;

fn gaussianBrushSq(distSq: f32, radiusSq: f32) -> f32 {
  return exp(((distSq / radiusSq) * -1f));
}

@group(0) @binding(2) var<storage, read_write> dyeA: array<vec4f, 65536>;

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 65536>;

fn smokeSplat(cx: u32, cy: u32) {
  let p = (&params);
  let idx = ((cy * 256u) + cx);
  let cellX = (f32(cx) + 0.5f);
  let cellY = (f32(cy) + 0.5f);
  let dx = (cellX - (*p).emitX);
  let dy = (cellY - (*p).emitY);
  let distSq = ((dx * dx) + (dy * dy));
  let radSq = max(((*p).emitRad * (*p).emitRad), 1f);
  let influence = gaussianBrushSq(distSq, radSq);
  let cell = (&dyeA[idx]);
  let oldDens = (*cell).x;
  let addDens = ((((*p).emitIntensity * influence) * (*p).dt) * 8f);
  let newDens = min((oldDens + addDens), 1f);
  let rejuvenate = (addDens / max(newDens, 0.0010000000474974513f));
  dyeA[idx] = vec4f(newDens, ((*cell).y * (1f - min(rejuvenate, 1f))), 0f, 0f);
  let vel = (&velA[idx]);
  let perpOff = (((dx * (*p).perpDirX) + (dy * (*p).perpDirY)) / max((*p).emitRad, 1f));
  let vmSq = max((((*p).emitVelX * (*p).emitVelX) + ((*p).emitVelY * (*p).emitVelY)), 1f);
  let tvx = ((*p).emitVelX + ((((*p).perpDirX * perpOff) * (*p).spreadFactor) * sqrt(vmSq)));
  let tvy = ((*p).emitVelY + ((((*p).perpDirY * perpOff) * (*p).spreadFactor) * sqrt(vmSq)));
  let br = min(((influence * (*p).dt) * 3f), 1f);
  let gravForce = ((((*p).gravity * oldDens) * (*p).dt) * 20.48f);
  let cursorDX = (cellX - (*p).cursorX);
  let cursorDY = (cellY - (*p).cursorY);
  let cursorDistSq = ((cursorDX * cursorDX) + (cursorDY * cursorDY));
  let cursorInf = (gaussianBrushSq(cursorDistSq, max((*p).mouseRadSq, 1f)) * (*p).mouseActive);
  velA[idx] = vec4f((mix((*vel).x, tvx, br) + ((*p).cursorVelX * cursorInf)), ((mix((*vel).y, tvy, br) + gravForce) + ((*p).cursorVelY * cursorInf)), (*vel).z, 0f);
}
fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 255i);
  let col = clamp((ji + dj), 0i, 255i);
  return u32(((row * 256i) + col));
}

@group(0) @binding(0) var<storage, read_write> velA: array<vec4f, 65536>;

fn smokeCurl(cx: u32, cy: u32) {
  let idx = ((cy * 256u) + cx);
  let ii = i32(cy);
  let ji = i32(cx);
  let vL = (&velA[nidx(ii, ji, 0i, -1i)]);
  let vR = (&velA[nidx(ii, ji, 0i, 1i)]);
  let vU = (&velA[nidx(ii, ji, -1i, 0i)]);
  let vD = (&velA[nidx(ii, ji, 1i, 0i)]);
  let curlZ = ((((*vR).y - (*vL).y) - ((*vD).x - (*vU).x)) * 0.5f);
  let vel = (&velA[idx]);
  velA[idx] = vec4f((*vel).x, (*vel).y, curlZ, 0f);
}
struct FluidParams {
  dt: f32,
  emitX: f32,
  emitY: f32,
  emitVelX: f32,
  emitVelY: f32,
  perpDirX: f32,
  perpDirY: f32,
  spreadFactor: f32,
  emitRad: f32,
  emitIntensity: f32,
  dyeFade: f32,
  velFade: f32,
  curlStrength: f32,
  gravity: f32,
  cursorX: f32,
  cursorY: f32,
  cursorVelX: f32,
  cursorVelY: f32,
  mouseActive: f32,
  mouseRadSq: f32,
  colorDecay: f32,
}

@group(0) @binding(6) var<uniform> params: FluidParams;

fn nidx(ii: i32, ji: i32, di: i32, dj: i32) -> u32 {
  let row = clamp((ii + di), 0i, 255i);
  let col = clamp((ji + dj), 0i, 255i);
