  n_sd: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = vec4f(toneLift(sRGBToP3(oklabToRgb((ribbonsField(uv, uniforms._sys.viewportSize, uniforms.n_sd.start, uniforms.n_sd.end, vec4f(uniforms.n_sd.amplitude, uniforms.n_sd.frequency, uniforms.n_sd.lineCount, uniforms.n_sd.lineWidth), vec4f(uniforms.n_sd.softness, uniforms.n_sd.spread, uniforms.n_sd.colorScale, uniforms.n_sd.colorVariance), vec4f(uniforms.n_sd.pinEdges, uniforms.n_sd._animTime, uniforms.n_sd._animTime_color, uniforms.n_sd.stopCount), uniforms.n_sd.colorsArray, uniforms.n_sd.positionsArray, uniforms.n_sd.convertedColorsArray)).rgb))), (ribbonsField(uv, uniforms._sys.viewportSize, uniforms.n_sd.start, uniforms.n_sd.end, vec4f(uniforms.n_sd.amplitude, uniforms.n_sd.frequency, uniforms.n_sd.lineCount, uniforms.n_sd.lineWidth), vec4f(uniforms.n_sd.softness, uniforms.n_sd.spread, uniforms.n_sd.colorScale, uniforms.n_sd.colorVariance), vec4f(uniforms.n_sd.pinEdges, uniforms.n_sd._animTime, uniforms.n_sd._animTime_color, uniforms.n_sd.stopCount), uniforms.n_sd.colorsArray, uniforms.n_sd.positionsArray, uniforms.n_sd.convertedColorsArray)).a);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
