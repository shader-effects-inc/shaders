  let dx = (uv.x - 0.5f);
  let dy = (uv.y - 0.5f);
  let rotRad = (rot * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = mix(polygonSdf(rdx, rdy, r, n), circleSdf(rdx, rdy, r), round_1);
  return vec4f(dist, 0f, 0f, 1f);
}

