fn polygonSdf(dx: f32, dy: f32, radius: f32, sides: f32) -> f32 {
  let len = sqrt(((dx * dx) + (dy * dy)));
  let angle = atan2(dy, dx);
  let sectorAngle = (6.283185307179586f / sides);
  let sectorIdx = floor(((angle / sectorAngle) + 0.5f));
  let canonicalAngle = (angle - (sectorIdx * sectorAngle));
  return ((len * cos(canonicalAngle)) - radius);
}

fn circleSdf(dx: f32, dy: f32, radius: f32) -> f32 {
