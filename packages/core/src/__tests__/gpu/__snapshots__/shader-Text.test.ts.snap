// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Text (a) glyph atlas sampling + placement > samples its rectangle of the glyph atlas at the placement body, reads half-extents > final-pass 1`] = `
"fn orientedBoxField(uv: vec2f, aspect: f32, center: vec2f, rotationDeg: f32, halfW: f32, halfH: f32) -> vec3f {
  let aspectUV = vec2f((uv.x * aspect), uv.y);
  let centerPos = vec2f((center.x * aspect), (1f - center.y));
  let dx = (aspectUV.x - centerPos.x);
  let dy = (aspectUV.y - centerPos.y);
  let rotRad = (rotationDeg * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  let localU = ((rdx / (halfW * 2f)) + 0.5f);
  let localV = ((rdy / (halfH * 2f)) + 0.5f);
  let insideMask = (((step(0f, localU) * step(localU, 1f)) * step(0f, localV)) * step(localV, 1f));
  return vec3f(localU, localV, insideMask);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  fontWeight: f32,
  italic: f32,
  fontSize: f32,
  letterSpacing: f32,
  lineHeight: f32,
  width: f32,
  color: vec4f,
  center: vec2f,
  rotation: f32,
  halfW: f32,
  halfH: f32,
  glyphRect: vec4f,
  _opacity: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_txt: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

@group(1) @binding(0) var media_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn catmullRomAxisPositions(uv: f32, texSize: f32) -> vec3f {
  let samplePos = (uv * texSize);
  let texPos1 = (floor((samplePos - 0.5f)) + 0.5f);
  let f = (samplePos - texPos1);
  let w1 = (1f + ((f * f) * (-2.5f + (1.5f * f))));
  let w2 = (f * (0.5f + (f * (2f - (1.5f * f)))));
  let w12 = max((w1 + w2), 1e-6f);
  let offset12 = (w2 / w12);
  return vec3f(((texPos1 - 1f) / texSize), ((texPos1 + offset12) / texSize), ((texPos1 + 2f) / texSize));
}

fn catmullRomAxisWeights(uv: f32, texSize: f32) -> vec3f {
  let samplePos = (uv * texSize);
  let texPos1 = (floor((samplePos - 0.5f)) + 0.5f);
  let f = (samplePos - texPos1);
  let w0 = (f * (-0.5f + (f * (1f - (0.5f * f)))));
  let w1 = (1f + ((f * f) * (-2.5f + (1.5f * f))));
  let w2 = (f * (0.5f + (f * (2f - (1.5f * f)))));
  let w3 = ((f * f) * (-0.5f + (0.5f * f)));
  return vec3f(w0, (w1 + w2), w3);
}

fn shapeCoverage(coverage: f32, rgb: vec3f) -> f32 {
  let lightness = pow(saturate(dot(rgb, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023))), 0.4545454545f);
  let fuller = (1f - pow((1f - coverage), 1.8f));
  let leaner = pow(coverage, 1.8f);
  return mix(fuller, leaner, lightness);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let glyphFrame_5 = orientedBoxField(uv, uniforms._sys.aspect, uniforms.n_txt.center, uniforms.n_txt.rotation, uniforms.n_txt.halfW, uniforms.n_txt.halfH);
  let covUV_0 = (uniforms.n_txt.glyphRect.xy + (glyphFrame_5.xy * uniforms.n_txt.glyphRect.zw));
  let covInside_3 = glyphFrame_5.z;
  let covSize_1 = vec2f(textureDimensions(media_0));
  let covFootprint_2 = max(length(dpdx(covUV_0 * covSize_1)), length(dpdy(covUV_0 * covSize_1)));
  var coverage_4 = 0.0;
  if (covInside_3 > 0.5) {
  if (covFootprint_2 >= 1.0) {
  let covOffset_6 = vec2f(min(covFootprint_2, 4.0) * 0.25) / covSize_1;
  coverage_4 = 0.25 * (textureSampleLevel(media_0, linearClamp, covUV_0 + vec2f(-covOffset_6.x, -covOffset_6.y), 0.0).r + textureSampleLevel(media_0, linearClamp, covUV_0 + vec2f(covOffset_6.x, -covOffset_6.y), 0.0).r + textureSampleLevel(media_0, linearClamp, covUV_0 + vec2f(-covOffset_6.x, covOffset_6.y), 0.0).r + textureSampleLevel(media_0, linearClamp, covUV_0 + vec2f(covOffset_6.x, covOffset_6.y), 0.0).r);
  } else {
  let covPosX_7 = catmullRomAxisPositions(covUV_0.x, covSize_1.x);
  let covPosY_8 = catmullRomAxisPositions(covUV_0.y, covSize_1.y);
  let covWx_9 = catmullRomAxisWeights(covUV_0.x, covSize_1.x);
  let covWy_10 = catmullRomAxisWeights(covUV_0.y, covSize_1.y);
  coverage_4 = clamp(textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.x, covPosY_8.x), 0.0).r * (covWx_9.x * covWy_10.x) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.y, covPosY_8.x), 0.0).r * (covWx_9.y * covWy_10.x) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.z, covPosY_8.x), 0.0).r * (covWx_9.z * covWy_10.x) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.x, covPosY_8.y), 0.0).r * (covWx_9.x * covWy_10.y) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.y, covPosY_8.y), 0.0).r * (covWx_9.y * covWy_10.y) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.z, covPosY_8.y), 0.0).r * (covWx_9.z * covWy_10.y) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.x, covPosY_8.z), 0.0).r * (covWx_9.x * covWy_10.z) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.y, covPosY_8.z), 0.0).r * (covWx_9.y * covWy_10.z) + textureSampleLevel(media_0, linearClamp, vec2f(covPosX_7.z, covPosY_8.z), 0.0).r * (covWx_9.z * covWy_10.z), 0.0, 1.0);
  }
  }
  var composed_11 = vec4f(uniforms.n_txt.color.rgb, (shapeCoverage(coverage_4, uniforms.n_txt.color.rgb) * uniforms.n_txt.color.a));
  return vec4f(linearToSrgb(tone_linear(composed_11.rgb)), composed_11.a);
}"
`;
