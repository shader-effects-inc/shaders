@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = embossComposite(unpremultiplyAlpha(textureSample(rtt_0, linearClamp, embossWarpUV(uv, uniforms.n_e.center, (analyticSdf_circleSDF(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, uniforms.n_e.depth))), (analyticSdf_circleSDF(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(offsetUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), 0.003, 0.0), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(offsetUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), -0.003, 0.0), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(offsetUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), 0.0, 0.003), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(offsetUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), 0.0, -0.003), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(embossTraceUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), uniforms.n_e.lightAngle, uniforms.n_e.depth, 0.5), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, (analyticSdf_circleSDF(embossTraceUV(sdfSpaceUV(uniforms.n_e.center, uniforms.n_e.scale, uniforms.n_e.rotation, uv, uniforms._sys.aspect), uniforms.n_e.lightAngle, uniforms.n_e.depth, 1.0), uniforms.n_e._saRadius, uniforms.n_e._saSides, uniforms.n_e._saRounding, uniforms.n_e._saInnerRatio, uniforms.n_e._saRotation, uniforms.n_e._saHeight, uniforms.n_e._saOffset, uniforms.n_e._saAperture)).r, uniforms.n_e.depth, uniforms.n_e.lightAngle, uniforms.n_e.lightIntensity, uniforms.n_e.shadowIntensity, 0.0);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
