  var composed_0 = gradientMapCompose(genBody(uv), gradientMapCosine(gradientMapT(genBody(uv), uniforms.n_gm.blackPoint, uniforms.n_gm.whitePoint, uniforms.n_gm.contrast), (uniforms.n_gm.speed * uniforms._sys.time), vec3f(0.5, 0.5, 0.5), vec3f(0.5, 0.5, 0.5), vec3f(1.0, 1.0, 1.0), vec3f(0.0, 0.333, 0.667)), uniforms.n_gm.strength);
