exports[`GradientMap (a) cosine palette path > rainbow: cosine palette + strength compose, no mixColors, no RTT > cosine-final-pass 1`] = `
"fn gradientMapCompose(color: vec4f, mapped: vec3f, strength: f32) -> vec4f {
  let outRgb = mix(color.xyz, mapped, vec3f(strength, strength, strength));
  return vec4f(outRgb, color.w);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

fn gradientMapCosine(t: f32, phase: f32, pa: vec3f, pb: vec3f, pc: vec3f, pd: vec3f) -> vec3f {
  let arg = ((((pc * t) + pd) + vec3f(phase, phase, phase)) * 6.283185307179586f);
  let mapped = (pa + (pb * cos(arg)));
  return clamp(mapped, vec3f(), vec3f(1));
}

fn gradientMapT(color: vec4f, black: f32, white: f32, contrast: f32) -> f32 {
  let luma = dot(color.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let range = max((white - black), 1e-4f);
  var t = clamp(((luma - black) / range), 0f, 1f);
  t = clamp((((t - 0.5f) * contrast) + 0.5f), 0f, 1f);
  return t;
}

