exports[`GradientMap (b) custom colors path > custom: 3-stop cyclic mixColors + select in the compile-time colorSpace > custom-final-pass 1`] = `
"fn gradientMapCompose(color: vec4f, mapped: vec3f, strength: f32) -> vec4f {
