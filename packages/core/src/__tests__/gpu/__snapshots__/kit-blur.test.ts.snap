exports[`bloom extract graphs (GPU-free) > map-driven extract adds the source tap and the shared remap > bloom-extract-map 1`] = `
"@group(0) @binding(0) var childTexture: texture_2d<f32>;

@group(0) @binding(1) var source: texture_2d<f32>;

@group(0) @binding(2) var brightMap: texture_storage_2d<rgba16float, write>;

@group(0) @binding(3) var blurMap: texture_storage_2d<rgba32float, write>;

struct Params {
  threshold: f32,
  inputWidth: f32,
  inputHeight: f32,
  inputMin: f32,
  inputMax: f32,
  outputMin: f32,
  outputMax: f32,
  curve: f32,
}

@group(0) @binding(4) var<uniform> params: Params;

fn bloomExtractSoftKnee(childTexture_1: texture_2d<f32>, cx: u32, cy: u32, inputSize: vec2f, computeSize: vec2f, threshold: f32) -> vec4f {
  let iw = inputSize.x;
  let ih = inputSize.y;
  let inputWm1 = i32((iw - 1f));
  let inputHm1 = i32((ih - 1f));
  var sample = vec4f();
  for (var ty = 0; (ty < 4i); ty++) {
    for (var tx = 0; (tx < 4i); tx++) {
      let su = ((f32(cx) + ((f32(tx) + 0.5f) / 4f)) / computeSize.x);
      let sv = ((f32(cy) + ((f32(ty) + 0.5f) / 4f)) / computeSize.y);
      let sx = clamp(i32((su * iw)), 0i, inputWm1);
      let sy = clamp(i32((sv * ih)), 0i, inputHm1);
      sample = (sample + textureLoad(childTexture_1, vec2u(u32(sx), u32(sy)), 0));
    }
  }
  sample = (sample * 0.0625f);
  let knee = ((threshold * 0.5f) + 1e-4f);
  let lum = dot(sample.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let soft = clamp(((lum - threshold) + knee), 0f, (knee * 2f));
  let softCurve = ((soft * soft) / (knee * 4f));
  let mask = (max(softCurve, (lum - threshold)) / max(lum, 1e-4f));
  return vec4f((sample.xyz * mask), (sample.w * mask));
}

fn mapSourceScalar_alpha(sample: vec4f) -> f32 {
  return sample.w;
}

fn applyRemapWindow(raw: f32, inputMin: f32, inputMax: f32, outputMin: f32, outputMax: f32, curve: f32) -> f32 {
  let inputRange = max((inputMax - inputMin), 1e-4f);
  let normalised = clamp(((raw - inputMin) / inputRange), 0f, 1f);
  let exponent = pow(2f, (-(curve) * 2f));
  let eased = pow(normalised, exponent);
  return mix(outputMin, outputMax, eased);
}

fn testBloomExtractMap(cx: u32, cy: u32) {
  let p = (&params);
  let iw = (*p).inputWidth;
  let ih = (*p).inputHeight;
  let bright = bloomExtractSoftKnee(childTexture, cx, cy, vec2f(iw, ih), vec2f(1024, 640), (*p).threshold);
  textureStore(brightMap, vec2u(cx, cy), bright);
  let u = ((f32(cx) + 0.5f) / 1024f);
  let v = ((f32(cy) + 0.5f) / 640f);
  let srcX = clamp(i32(round((u * iw))), 0i, i32((iw - 1f)));
  let srcY = clamp(i32(round((v * ih))), 0i, i32((ih - 1f)));
  let mapSample = textureLoad(source, vec2u(u32(srcX), u32(srcY)), 0);
  let radius = applyRemapWindow(mapSourceScalar_alpha(mapSample), (*p).inputMin, (*p).inputMax, (*p).outputMin, (*p).outputMax, (*p).curve);
  textureStore(blurMap, vec2u(cx, cy), vec4f(radius, 0f, 0f, 1f));
}"
`;

exports[`bloom extract graphs (GPU-free) > uniform-radius extract resolves, names its kernel, writes bright + radius > bloom-extract-uniform 1`] = `
"@group(0) @binding(0) var childTexture: texture_2d<f32>;

@group(0) @binding(1) var brightMap: texture_storage_2d<rgba16float, write>;

@group(0) @binding(2) var blurMap: texture_storage_2d<rgba32float, write>;

struct Params {
  threshold: f32,
  size: f32,
  inputWidth: f32,
  inputHeight: f32,
}

@group(0) @binding(3) var<uniform> params: Params;

fn bloomExtractSoftKnee(childTexture_1: texture_2d<f32>, cx: u32, cy: u32, inputSize: vec2f, computeSize: vec2f, threshold: f32) -> vec4f {
  let iw = inputSize.x;
  let ih = inputSize.y;
  let inputWm1 = i32((iw - 1f));
  let inputHm1 = i32((ih - 1f));
  var sample = vec4f();
  for (var ty = 0; (ty < 4i); ty++) {
    for (var tx = 0; (tx < 4i); tx++) {
      let su = ((f32(cx) + ((f32(tx) + 0.5f) / 4f)) / computeSize.x);
      let sv = ((f32(cy) + ((f32(ty) + 0.5f) / 4f)) / computeSize.y);
      let sx = clamp(i32((su * iw)), 0i, inputWm1);
      let sy = clamp(i32((sv * ih)), 0i, inputHm1);
      sample = (sample + textureLoad(childTexture_1, vec2u(u32(sx), u32(sy)), 0));
    }
  }
  sample = (sample * 0.0625f);
  let knee = ((threshold * 0.5f) + 1e-4f);
  let lum = dot(sample.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let soft = clamp(((lum - threshold) + knee), 0f, (knee * 2f));
  let softCurve = ((soft * soft) / (knee * 4f));
  let mask = (max(softCurve, (lum - threshold)) / max(lum, 1e-4f));
  return vec4f((sample.xyz * mask), (sample.w * mask));
}

fn testBloomExtract(cx: u32, cy: u32) {
  let p = (&params);
  let bright = bloomExtractSoftKnee(childTexture, cx, cy, vec2f((*p).inputWidth, (*p).inputHeight), vec2f(1024, 640), (*p).threshold);
  textureStore(brightMap, vec2u(cx, cy), bright);
  textureStore(blurMap, vec2u(cx, cy), vec4f((*p).size, 0f, 0f, 1f));
}"
`;
