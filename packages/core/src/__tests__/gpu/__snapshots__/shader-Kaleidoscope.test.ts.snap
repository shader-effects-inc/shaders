// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Kaleidoscope (a) analytic UV fold over a generator > folds Kaleidoscope.uvRemap into the generator sample coordinate (inline, no RTT) > final-pass-uvremap 1`] = `
"fn edgeClampUV(uv: vec2f) -> vec2f {
  return clamp(uv, vec2f(), vec2f(1));
}

fn kaleidoscopeUV(center: vec2f, segments: f32, angle: f32, uv: vec2f, aspect: f32) -> vec2f {
  let aspectCorrectedUV = vec2f((uv.x * aspect), uv.y);
  let centerPos = vec2f((center.x * aspect), (1f - center.y));
  let delta = (aspectCorrectedUV - centerPos);
  let radius = length(delta);
  let currentAngle = atan2(delta.y, delta.x);
  let rotatedAngle = (currentAngle + (angle * 0.017453292519943295f));
  let segmentAngle = (6.283185307179586f / segments);
  let segTwo = (segmentAngle * 2f);
  let wrappedAngle = (rotatedAngle - (segTwo * floor((rotatedAngle / segTwo))));
  let finalAngle = select(wrappedAngle, (segTwo - wrappedAngle), (wrappedAngle > segmentAngle));
  let kaleidoscopeX = (cos(finalAngle) * radius);
  let kaleidoscopeY = (sin(finalAngle) * radius);
  let kaleidoscopePos = (centerPos + vec2f(kaleidoscopeX, kaleidoscopeY));
  return vec2f((kaleidoscopePos.x / aspect), kaleidoscopePos.y);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  center: vec2f,
  segments: f32,
  angle: f32,
  edges: f32,
  _opacity: f32,
  _pad0: f32,
}

struct padded_2 {
  seed: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct struct_1 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_ka: padded_1,
  n_gen: padded_2,
  _sys: struct_1,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn genBody(seed: f32, uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, seed, 1f);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let foldUV_0 = edgeClampUV(kaleidoscopeUV(uniforms.n_ka.center, uniforms.n_ka.segments, uniforms.n_ka.angle, uv, uniforms._sys.aspect));
  var composed_1 = genBody(uniforms.n_gen.seed, foldUV_0);
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;

exports[`Kaleidoscope (b) RTT filter path (fragment) > converts the child to a texture, samples the fold, unpremultiplies > final-pass-fragment 1`] = `
"fn overComposite(base: vec4f, blended: vec3f, overlayAlpha: f32) -> vec4f {
  let baseWeight = (base.w * (1f - overlayAlpha));
  let finalAlpha = (overlayAlpha + baseWeight);
  let rgb = ((blended * overlayAlpha) + (base.xyz * baseWeight));
  return vec4f(rgb, finalAlpha);
}

fn blend_normal(base: vec4f, overlay: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay.w * opacity);
  return overComposite(base, overlay.xyz, overlayAlpha);
}

fn unpremultiplyAlpha(color: vec4f) -> vec4f {
  let alpha = color.w;
  let straightRGB = select(vec3f(), (color.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(0) var rtt_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn edgeMirrorUV(uv: vec2f) -> vec2f {
  let mirrorX = (abs(uv.x) % 2f);
  let mirrorY = (abs(uv.y) % 2f);
  return vec2f(select(mirrorX, (2f - mirrorX), (mirrorX >= 1f)), select(mirrorY, (2f - mirrorY), (mirrorY >= 1f)));
}

fn kaleidoscopeUV(center: vec2f, segments: f32, angle: f32, uv: vec2f, aspect: f32) -> vec2f {
  let aspectCorrectedUV = vec2f((uv.x * aspect), uv.y);
  let centerPos = vec2f((center.x * aspect), (1f - center.y));
  let delta = (aspectCorrectedUV - centerPos);
  let radius = length(delta);
  let currentAngle = atan2(delta.y, delta.x);
  let rotatedAngle = (currentAngle + (angle * 0.017453292519943295f));
  let segmentAngle = (6.283185307179586f / segments);
  let segTwo = (segmentAngle * 2f);
  let wrappedAngle = (rotatedAngle - (segTwo * floor((rotatedAngle / segTwo))));
  let finalAngle = select(wrappedAngle, (segTwo - wrappedAngle), (wrappedAngle > segmentAngle));
  let kaleidoscopeX = (cos(finalAngle) * radius);
  let kaleidoscopeY = (sin(finalAngle) * radius);
  let kaleidoscopePos = (centerPos + vec2f(kaleidoscopeX, kaleidoscopeY));
  return vec2f((kaleidoscopePos.x / aspect), kaleidoscopePos.y);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  center: vec2f,
  segments: f32,
  angle: f32,
  edges: f32,
  _opacity: f32,
  _pad0: f32,
}

struct padded_2 {
  seed: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct struct_1 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_ka: padded_1,
  n_gen: padded_2,
  _sys: struct_1,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = blend_normal(vec4f(1.0, 1.0, 1.0, 0.0), unpremultiplyAlpha(textureSample(rtt_0, linearClamp, edgeMirrorUV(kaleidoscopeUV(uniforms.n_ka.center, uniforms.n_ka.segments, uniforms.n_ka.angle, uv, uniforms._sys.aspect)))), uniforms.n_ka._opacity);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
