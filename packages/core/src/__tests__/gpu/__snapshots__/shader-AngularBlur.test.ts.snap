// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AngularBlur (a) RTT multi-tap filter path > RTTs the child, gathers it adaptively along the orbit trajectory, unpremultiplies > final-pass 1`] = `
"fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

fn motionBlurDetailField(uv: vec2f, center: vec2f, aspect: f32, dispersion: f32, falloff: f32, focus: f32, jitter: f32, viewport: vec2f) -> vec4f {
  let centerPos = vec2f(center.x, (1f - center.y));
  let dx = ((uv.x - centerPos.x) * aspect);
  let dy = (uv.y - centerPos.y);
  let dist = sqrt(((dx * dx) + (dy * dy)));
  let farX = (max(centerPos.x, (1f - centerPos.x)) * aspect);
  let farY = max(centerPos.y, (1f - centerPos.y));
  let dMax = max(sqrt(((farX * farX) + (farY * farY))), 1e-4f);
  let dNorm = clamp((dist / dMax), 0f, 1f);
  let ramp = mix(1f, (dNorm * dNorm), falloff);
  let strength = (dispersion * ramp);
  let dPos = max(strength, 0f);
  let dNeg = max((strength * -1f), 0f);
  let focusEdge = smoothstep((focus * 0.7f), ((focus * 1.3f) + 1e-4f), dNorm);
  let focusMask = mix(1f, focusEdge, step(1e-4f, focus));
  let px = vec2f((uv.x * viewport.x), (uv.y * viewport.y));
  let ign = fract((52.9829189f * fract(((px.x * 0.06711056f) + (px.y * 0.00583715f)))));
  let jitterPhase = ((ign - 0.5f) * jitter);
  return vec4f(dPos, dNeg, focusMask, jitterPhase);
}

fn angularBlurTapCoord(center: vec2f, intensity: f32, uv: vec2f, aspect: f32, tapIndex: f32) -> vec2f {
  let centerPos = vec2f(center.x, (1f - center.y));
  let angleStep = ((intensity * 5e-3f) / 31f);
  let angle = ((tapIndex - 15.5f) * angleStep);
  let cosA = cos(angle);
  let sinA = sin(angle);
  let initX = (uv.x - centerPos.x);
  let initY = (uv.y - centerPos.y);
  let acX = (initX * aspect);
  let acY = initY;
  let rotX = ((acX * cosA) - (acY * sinA));
  let rotY = ((acX * sinA) + (acY * cosA));
  return vec2f(((rotX / aspect) + centerPos.x), (rotY + centerPos.y));
}

fn orbitStreakTap(uv: vec2f, anchor: vec2f, amount: f32, aspect: f32, _viewport: vec2f, along: f32, bias: f32, jitter: f32, _spiral: f32) -> vec2f {
  let index = ((along + (bias * abs((along - 15.5f)))) + jitter);
  return angularBlurTapCoord(anchor, amount, uv, aspect, index);
}

fn motionBlurDetailTapWeight(sample: vec4f, weight: f32, tintForward: vec3f, tintReversed: vec3f, field: vec4f, highlightGain: f32) -> vec4f {
  let lum = dot(sample.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let boost = (weight * (1f + ((highlightGain * lum) * lum)));
  let tint = ((vec3f(1) + (tintForward * field.x)) + (tintReversed * field.y));
  return vec4f((tint.x * boost), (tint.y * boost), (tint.z * boost), boost);
}

fn motionBlurSpectrumChannel(raw: f32) -> f32 {
  let wrapped = (raw - (6f * floor((raw / 6f))));
  let c = clamp((abs((wrapped - 3f)) - 1f), 0f, 1f);
  return ((c * c) * (3f - (2f * c)));
}

fn motionBlurSpectrumTint(hue: f32) -> vec3f {
  let h6 = (hue * 6f);
  return vec3f((motionBlurSpectrumChannel(h6) - 1f), (motionBlurSpectrumChannel((h6 + 4f)) - 1f), (motionBlurSpectrumChannel((h6 + 2f)) - 1f));
}

fn motionBlurDetailResolve(colorSum: vec4f, weightSum: vec4f) -> vec4f {
  return (colorSum / max(weightSum, vec4f(9.999999747378752e-5)));
}

fn orbitMotionBlurAdaptive(tex: texture_2d<f32>, samp: sampler, uv: vec2f, anchor: vec2f, center: vec2f, aspect: f32, viewport: vec2f, lens: vec4f, streak: vec4f) -> vec4f {
  // lens = (dispersion, falloff, focus, bias); streak = (highlights, jitter, spiral, amount)
  let field = motionBlurDetailField(uv, center, aspect, lens.x, lens.y, lens.z, streak.y, viewport);
  let amount = streak.w * field.z;
  let first = orbitStreakTap(uv, anchor, amount, aspect, viewport, 0.0, lens.w, 0.0, streak.z);
  let last = orbitStreakTap(uv, anchor, amount, aspect, viewport, 31.0, lens.w, 0.0, streak.z);
  let lengthPx = length((last - first) * viewport);
  if (lengthPx < 0.5) {
    return textureSampleLevel(tex, samp, uv, 0.0);
  }
  let count = i32(clamp(ceil(lengthPx) + 1.0, 4.0, 32.0));
  let stride = 31.0 / f32(count - 1);
  // The detail field's jitter is in tap units of the 32-tap comb: rescale it to this comb.
  let jitter = field.w * stride;
  var colorSum = vec4f(0.0);
  var weightSum = vec4f(0.0);
  if (lens.x == 0.0 && streak.x == 0.0) {
    // No spectral tint and no highlight boost (the defaults): one scalar weight per tap.
    for (var i = 0; i < count; i++) {
      let along = f32(i) * stride;
      let coord = orbitStreakTap(uv, anchor, amount, aspect, viewport, along, lens.w, jitter, streak.z);
      let t = along / 31.0 * 2.0 - 1.0;
      let gauss = exp(t * t * -0.7812499999999999);
      colorSum += textureSampleLevel(tex, samp, coord, 0.0) * gauss;
      weightSum += vec4f(gauss);
    }
  } else {
    let gain = streak.x * 12.0;
    for (var i = 0; i < count; i++) {
      let along = f32(i) * stride;
      let coord = orbitStreakTap(uv, anchor, amount, aspect, viewport, along, lens.w, jitter, streak.z);
      let tap = textureSampleLevel(tex, samp, coord, 0.0);
      let f = along / 31.0;
      let t = f * 2.0 - 1.0;
      let gauss = exp(t * t * -0.7812499999999999);
      let weight = motionBlurDetailTapWeight(tap, gauss, motionBlurSpectrumTint(f * 0.75), motionBlurSpectrumTint((1.0 - f) * 0.75), field, gain);
      colorSum += tap * weight;
      weightSum += weight;
    }
  }
  return motionBlurDetailResolve(colorSum, weightSum);
}

@group(1) @binding(0) var rtt_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  intensity: f32,
  center: vec2f,
  dispersion: f32,
  falloff: f32,
  focus: f32,
  bias: f32,
  highlights: f32,
  jitter: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_ab: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = unpremultiplyAlpha(orbitMotionBlurAdaptive(rtt_0, linearClamp, uv, uniforms.n_ab.center, uniforms.n_ab.center, uniforms._sys.aspect, uniforms._sys.viewportSize, vec4f(uniforms.n_ab.dispersion, uniforms.n_ab.falloff, uniforms.n_ab.focus, uniforms.n_ab.bias), vec4f(uniforms.n_ab.highlights, uniforms.n_ab.jitter, 0.0, uniforms.n_ab.intensity)));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;

exports[`AngularBlur (d) detail gather > bias + jitter switch to the detail gather over angularBlurTapCoord > final-pass-detail 1`] = `
"fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
