fn motionBlurDetailTapWeight(sample: vec4f, weight: f32, tintForward: vec3f, tintReversed: vec3f, field: vec4f, highlightGain: f32) -> vec4f {
  let lum = dot(sample.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
