exports[`blend — resolve gate > representative modes resolve to WGSL (snapshot) 1`] = `
"fn overComposite(base: vec4f, blended: vec3f, overlayAlpha: f32) -> vec4f {
  let baseWeight = (base.w * (1f - overlayAlpha));
  let finalAlpha = (overlayAlpha + baseWeight);
  let rgb = ((blended * overlayAlpha) + (base.xyz * baseWeight));
  return vec4f(rgb, finalAlpha);
}

fn item(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  let blended = (base.xyz * overlay2.xyz);
  return overComposite(base, blended, overlayAlpha);
}

fn step3(edge: vec3f, x: vec3f) -> vec3f {
  return select(vec3f(), vec3f(1), (x >= edge));
}

fn item_1(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  let mult = ((base.xyz * overlay2.xyz) * 2f);
  let scr = (1f - (((1f - base.xyz) * (1f - overlay2.xyz)) * 2f));
  let blended = mix(mult, scr, step3(vec3f(0.5), base.xyz));
  return overComposite(base, blended, overlayAlpha);
}

fn luminance(rgb: vec3f) -> f32 {
  return (((rgb.x * 0.2126f) + (rgb.y * 0.7152f)) + (rgb.z * 0.0722f));
}

fn item_2(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  let baseLum = luminance(base.xyz);
  let overlayLum = luminance(overlay2.xyz);
  let baseChromaticity = (base.xyz - baseLum);
  let overlayChromaticity = (overlay2.xyz - overlayLum);
  let baseChromaLength = length(baseChromaticity);
  let overlayChromaLength = length(overlayChromaticity);
  let overlayChromaDir = select(vec3f(), (overlayChromaticity / overlayChromaLength), (overlayChromaLength > 1e-4f));
  let blended = ((overlayChromaDir * baseChromaLength) + baseLum);
  return overComposite(base, blended, overlayAlpha);
}

fn item_3(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  let mult = ((base.xyz * overlay2.xyz) * 2f);
  let baseSquared = (base.xyz * base.xyz);
  let softDark = (mult + (baseSquared * (1f - (overlay2.xyz * 2f))));
  let baseSqrt = sqrt(base.xyz);
  let softLightVal = (((base.xyz * (1f - overlay2.xyz)) * 2f) + (baseSqrt * ((overlay2.xyz * 2f) - 1f)));
  let blended = mix(softDark, softLightVal, step3(vec3f(0.5), overlay2.xyz));
  return overComposite(base, blended, overlayAlpha);
}

fn p3ToSRGB(p3: vec3f) -> vec3f {
  let r = (((p3.x * 1.2249401f) - (p3.y * 0.2249404f)) - (p3.z * 0f));
  let g = (((p3.x * -0.0420569f) + (p3.y * 1.0420571f)) + (p3.z * 0f));
  let b = (((p3.x * -0.0196376f) - (p3.y * 0.0786361f)) + (p3.z * 1.0982735f));
  return vec3f(r, g, b);
}

fn rgbToOklab(rgb: vec3f) -> vec3f {
  let r = rgb.x;
  let g = rgb.y;
  let b = rgb.z;
  let l = (((r * 0.4122214708f) + (g * 0.5363325363f)) + (b * 0.0514459929f));
  let m = ((r * 0.2119034982f) + ((g * 0.6806995451f) + (b * 0.1073969566f)));
  let s = (((r * 0.0883024619f) + (g * 0.2817188376f)) + (b * 0.6299787005f));
  let l_ = (sign(l) * pow(abs(l), 0.3333333333333333f));
  let m_ = (sign(m) * pow(abs(m), 0.3333333333333333f));
  let s_ = (sign(s) * pow(abs(s), 0.3333333333333333f));
  return vec3f((((l_ * 0.2104542553f) + (m_ * 0.793617785f)) - (s_ * 0.0040720468f)), (((l_ * 1.9779984951f) - (m_ * 2.428592205f)) + (s_ * 0.4505937099f)), (((l_ * 0.0259040371f) + (m_ * 0.7827717662f)) - (s_ * 0.808675766f)));
}

fn oklabToOklch(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let C = sqrt(((a * a) + (b * b)));
  let h = atan2(b, a);
  return vec3f(L, C, h);
}

fn mixHueShortest(hA: f32, cA: f32, hB: f32, cB: f32, wB: f32, sw: f32, achromatic: f32) -> f32 {
  let hueA = select(hA, hB, (cA < achromatic));
  let hueB = select(hB, hueA, (cB < achromatic));
  let diff = (hueB - hueA);
  let wrapped = (diff - (floor(((diff + 3.14159265359f) * 0.15915494309f)) * 6.28318530718f));
  return (hueA + (wrapped * (wB / sw)));
}

fn oklchToOklab(lch: vec3f) -> vec3f {
  let L = lch.x;
  let C = lch.y;
  let h = lch.z;
  return vec3f(L, (C * cos(h)), (C * sin(h)));
}

fn oklabToRgb(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let l_ = ((L + (a * 0.3963377774f)) + (b * 0.2158037573f));
  let m_ = ((L - (a * 0.1055613458f)) - (b * 0.0638541728f));
  let s_ = ((L - (a * 0.0894841775f)) - (b * 1.291485548f));
  let l = pow(l_, 3f);
