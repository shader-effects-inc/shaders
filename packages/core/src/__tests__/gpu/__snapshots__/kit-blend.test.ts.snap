  let s = pow(s_, 3f);
  return vec3f((((l * 4.0767416621f) - (m * 3.3077115913f)) + (s * 0.2309699292f)), (((l * -1.2684380046f) + (m * 2.6097574011f)) - (s * 0.3413193965f)), (((l * -0.0041960863f) - (m * 0.7034186147f)) + (s * 1.707614701f)));
}

fn sRGBToP3(srgb: vec3f) -> vec3f {
  let r = (((srgb.x * 0.8224621f) + (srgb.y * 0.177538f)) + (srgb.z * 0f));
  let g = (((srgb.x * 0.0331941f) + (srgb.y * 0.9668058f)) + (srgb.z * 0f));
  let b = (((srgb.x * 0.0170826f) + (srgb.y * 0.0723974f)) + (srgb.z * 0.9105199f));
  return vec3f(r, g, b);
}

fn item_4(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  let baseWeight = (base.w * (1f - overlayAlpha));
  let finalAlpha = (overlayAlpha + baseWeight);
  let baseOklch = oklabToOklch(rgbToOklab(p3ToSRGB(base.xyz)));
  let overlayOklch = oklabToOklch(rgbToOklab(p3ToSRGB(overlay2.xyz)));
  let blendedOklch = ((overlayOklch * overlayAlpha) + (baseOklch * baseWeight));
  let hue2 = mixHueShortest(baseOklch.z, baseOklch.y, overlayOklch.z, overlayOklch.y, overlayAlpha, max(finalAlpha, 1e-3f), 1e-3f);
  let rgb = sRGBToP3(oklabToRgb(oklchToOklab(vec3f(blendedOklch.x, blendedOklch.y, hue2))));
  return vec4f(rgb, finalAlpha);
}"
