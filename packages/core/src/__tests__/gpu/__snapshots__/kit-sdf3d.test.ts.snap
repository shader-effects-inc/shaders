fn sdf3d_sdRoundBox(p: vec3f, hx: f32, hy: f32, hz: f32, rounding: f32) -> f32 {
  let qx = ((abs(p.x) - hx) + rounding);
  let qy = ((abs(p.y) - hy) + rounding);
  let qz = ((abs(p.z) - hz) + rounding);
  let outer = length(vec3f(max(qx, 0f), max(qy, 0f), max(qz, 0f)));
  let inner = min(max(qx, max(qy, qz)), 0f);
  return ((outer + inner) - rounding);
}

fn item(p: vec3f, ringR: f32, tubeR: f32) -> f32 {
  let qx = (length(vec2f(p.x, p.z)) - ringR);
  return (length(vec2f(qx, p.y)) - tubeR);
}

fn item_1(p: vec3f, s: f32) -> f32 {
  return ((((abs(p.x) + abs(p.y)) + abs(p.z)) - s) * 0.57735027f);
}

fn item_2(p: vec3f, r: f32, h: f32, rounding: f32) -> f32 {
  let dx = ((length(vec2f(p.x, p.z)) - r) + rounding);
  let dy = ((abs(p.y) - h) + rounding);
  let inner = min(max(dx, dy), 0f);
  let outer = length(vec2f(max(dx, 0f), max(dy, 0f)));
  return ((inner + outer) - rounding);
}

fn item_3(p: vec3f, r: f32, h: f32) -> f32 {
  let cyc = clamp(p.y, (h * -1f), h);
  return (length(vec3f(p.x, (p.y - cyc), p.z)) - r);
}

fn item_4(p: vec3f, r1: f32, r2: f32, h: f32) -> f32 {
  let qx = length(vec2f(p.x, p.z));
  let qy = p.y;
  let k2x = (r2 - r1);
  let k2y = (h * 2f);
  let cax = (qx - min(qx, select(r2, r1, (qy < 0f))));
  let cay = (abs(qy) - h);
  let dotNum = (((r2 - qx) * k2x) + ((h - qy) * k2y));
  let dotDen = max(((k2x * k2x) + (k2y * k2y)), 1e-6f);
  let t = clamp((dotNum / dotDen), 0f, 1f);
  let cbx = ((qx - r2) + (k2x * t));
  let cby = ((qy - h) + (k2y * t));
  let sInner = select(1f, -1f, (cay < 0f));
  let s = select(1f, sInner, (cbx < 0f));
  let dca = ((cax * cax) + (cay * cay));
  let dcb = ((cbx * cbx) + (cby * cby));
  return (s * sqrt(min(dca, dcb)));
}

fn item_5(p: vec3f, b: f32, ht: f32) -> f32 {
  let h2 = (ht * 0.5f);
  let denom = sqrt(((ht * ht) + (b * b)));
  let dx = (((ht * abs(p.x)) + (b * (p.y - h2))) / denom);
  let dz = (((ht * abs(p.z)) + (b * (p.y - h2))) / denom);
  let dBase = ((p.y * -1f) - h2);
  return max(max(dx, dz), dBase);
}

fn item_6(p: vec3f, r: f32, he: f32) -> f32 {
  const kx = -0.8660254;
  const ky = 0.5;
  const kz = 0.57735;
  let ax = abs(p.x);
  let ay = abs(p.y);
  let az = abs(p.z);
  let dk = (min(((kx * ax) + (ky * ay)), 0f) * 2f);
  let px = (ax - (dk * kx));
  let py = (ay - (dk * ky));
  let cx = clamp(px, ((kz * r) * -1f), (kz * r));
  let ex = (px - cx);
  let ey = (py - r);
  let dHex = (sqrt(((ex * ex) + (ey * ey))) * sign((py - r)));
  let dZ = (az - he);
  let inner = min(max(dHex, dZ), 0f);
  let outer = length(vec2f(max(dHex, 0f), max(dZ, 0f)));
  return (inner + outer);
}

fn item_7(p: vec3f, rx: f32, ry: f32, rz: f32) -> f32 {
  let k0 = length(vec3f((p.x / rx), (p.y / ry), (p.z / rz)));
  let k1 = length(vec3f((p.x / (rx * rx)), (p.y / (ry * ry)), (p.z / (rz * rz))));
  return ((k0 * (k0 - 1f)) / max(k1, 1e-6f));
}

fn item_8(p: vec3f, r: f32, h: f32) -> f32 {
  let qx = length(vec2f(p.x, p.z));
