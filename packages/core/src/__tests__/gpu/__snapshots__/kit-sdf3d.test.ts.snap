"struct RotStruct {
  cx: f32,
  sx: f32,
  cy: f32,
  sy: f32,
  cz: f32,
  sz: f32,
}

fn rotateVec3(v: vec3f, rot: RotStruct) -> vec3f {
  let x1 = ((v.x * rot.cy) + (v.z * rot.sy));
  let z1 = ((v.z * rot.cy) - (v.x * rot.sy));
  let y2 = ((v.y * rot.cx) - (z1 * rot.sx));
  let z2 = ((v.y * rot.sx) + (z1 * rot.cx));
  let x3 = ((x1 * rot.cz) - (y2 * rot.sz));
  let y3 = ((x1 * rot.sz) + (y2 * rot.cz));
  return vec3f(x3, y3, z2);
}

fn sdf3d_sdSphere(p: vec3f, r: f32) -> f32 {
  return (length(p) - r);
}

fn sdfFn(p: vec3f) -> f32 {
  return sdf3d_sdSphere(p, 0.35f);
}

fn raymarchedField(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let ro0 = vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f);
  let rd0 = vec3f(0, 0, 1);
  let ro = rotateVec3(ro0, rot);
  let rd = rotateVec3(rd0, rot);
  let steps = i32(clamp((rBound * 220f), 96f, 384f));
  let b = dot(ro, rd);
  let perp = sqrt(max((dot(ro, ro) - (b * b)), 0f));
  let halfSpan = sqrt(max(((rBound * rBound) - (perp * perp)), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  var t = tStart;
  var tPrev = tStart;
  var minD = 10f;
  var tMinD = tStart;
  var hit = 0f;
  for (var i = 0; (i < steps); i++) {
    let p = (ro + (rd * t));
    let dd = sdfFn(p);
    if ((dd < minD)) {
      minD = dd;
      tMinD = t;
    }
    if ((dd < 0f)) {
      hit = 1f;
      break;
    }
    if ((t > tEnd)) {
      break;
    }
    tPrev = t;
    t = (t + max(dd, 2e-3f));
  }
  if (((hit < 0.5f) && (minD < 0.15f))) {
    let reach = (max(minD, 2e-3f) * 2f);
    var lo = (tMinD - reach);
    var hi = (tMinD + reach);
    for (var i = 0; (i < 5i); i++) {
      let m1 = (hi - ((hi - lo) * 0.618034f));
      let m2 = (lo + ((hi - lo) * 0.618034f));
      let f1 = sdfFn((ro + (rd * m1)));
      let f2 = sdfFn((ro + (rd * m2)));
      if ((f1 < f2)) {
        hi = m2;
      }
      else {
        lo = m1;
      }
    }
    minD = min(minD, sdfFn((ro + (rd * ((lo + hi) * 0.5f)))));
  }
  var fieldVal = minD;
  let patternU = 0f;
  let patternV = 0f;
  var viewDepth = (tEnd + 0.4f);
  if ((hit > 0.5f)) {
    var eLo = tPrev;
    var eHi = t;
    var dLo = sdfFn((ro + (rd * eLo)));
    var dHi = sdfFn((ro + (rd * eHi)));
    for (var i = 0; (i < 10i); i++) {
      let mid = ((eLo + eHi) * 0.5f);
      let dm = sdfFn((ro + (rd * mid)));
      if ((dm > 0f)) {
        eLo = mid;
        dLo = dm;
      }
      else {
        eHi = mid;
        dHi = dm;
      }
    }
    let tEnter = (eLo + ((eHi - eLo) * clamp((dLo / max((dLo - dHi), 1e-9f)), 0f, 1f)));
    var tExit = tEnter;
    {
      let roB = (ro + (rd * tEnd));
      let span = ((tEnd - tStart) + 0.01f);
      var s = 0f;
      var sPrev = 0f;
      for (var i = 0; (i < steps); i++) {
        let p = (roB - (rd * s));
        let dd = sdfFn(p);
        if ((dd < 0f)) {
          break;
        }
        if ((s > span)) {
          break;
        }
        sPrev = s;
        s = (s + max(dd, 2e-3f));
      }
      var xLo = sPrev;
      var xHi = s;
      var hLo = sdfFn((roB - (rd * xLo)));
      var hHi = sdfFn((roB - (rd * xHi)));
      for (var i = 0; (i < 10i); i++) {
        let mid = ((xLo + xHi) * 0.5f);
        let dm = sdfFn((roB - (rd * mid)));
        if ((dm > 0f)) {
          xLo = mid;
          hLo = dm;
        }
        else {
          xHi = mid;
          hHi = dm;
        }
      }
      tExit = (tEnd - (xLo + ((xHi - xLo) * clamp((hLo / max((hLo - hHi), 1e-9f)), 0f, 1f))));
    }
    let halfChord = (max((tExit - tEnter), 0f) * 0.5f);
    fieldVal = (halfChord * -1f);
    viewDepth = tEnter;
  }
  return vec4f(fieldVal, patternU, patternV, viewDepth);
}

