  let dxx = (apx - (abx * t));
  let dyy = (apy - (aby * t));
  let dist = sqrt(((dxx * dxx) + (dyy * dyy)));
  return (dist * sign((((h * qx) + (r * qy)) - (r * h))));
}

fn item_9(p: vec3f, le: f32, r1: f32, r2: f32) -> f32 {
  let qy = max((abs(p.y) - le), 0f);
  let ring = (length(vec2f(p.x, qy)) - r1);
  return (length(vec2f(ring, p.z)) - r2);
}

fn item_10(a: f32, b: f32, k: f32) -> f32 {
  let h = clamp(((((b - a) / k) * 0.5f) + 0.5f), 0f, 1f);
  return (mix(b, a, h) - ((k * h) * (1f - h)));
}

fn item_11(p: vec3f, r: f32, h: f32, sides: f32) -> f32 {
  let base = item_8(p, r, h);
  let lenXZ = length(vec2f(p.x, p.z));
  let ang = atan2(p.z, p.x);
  let sector = (6.283185307179586f / sides);
  let idx = floor(((ang / sector) + 0.5f));
  let ca = (ang - (idx * sector));
  let ri = (r * cos((3.141592653589793f / sides)));
  let facet = ((lenXZ * cos(ca)) - ri);
  let dd = max(base, facet);
  let table = (p.y - (h * 0.45f));
  return max(dd, table);
}

fn item_12(p: vec3f, R: f32, tube: f32, pitch: f32, turns: f32) -> f32 {
  let psi = atan2(p.z, p.x);
  let k = floor((((p.y / pitch) - (psi / 6.283185307179586f)) + 0.5f));
  let theta = (psi + (6.283185307179586f * k));
  let ccx = (R * cos(theta));
  let ccy = ((pitch * theta) / 6.283185307179586f);
  let ccz = (R * sin(theta));
  let dStrand = (length(vec3f((p.x - ccx), (p.y - ccy), (p.z - ccz))) - tube);
  let slab = (abs(p.y) - ((pitch * turns) * 0.5f));
  return max(dStrand, slab);
}

fn item_13(p: vec3f, b0: vec3f, b1: vec3f, b2: vec3f, b3: vec3f, b4: vec3f, b5: vec3f, b6: vec3f, b7: vec3f, r: f32, k: f32) -> f32 {
  var balls = array<vec3f, 8>();
  balls[0i] = b0;
  balls[1i] = b1;
  balls[2i] = b2;
  balls[3i] = b3;
  balls[4i] = b4;
  balls[5i] = b5;
  balls[6i] = b6;
  balls[7i] = b7;
  var dd = (length((p - balls[0i])) - r);
  for (var i = 1; (i < 8i); i++) {
    dd = item_10(dd, (length((p - balls[i])) - r), k);
  }
  return dd;
}

fn item_14(p: vec3f, r: f32) -> f32 {
  let q = vec3f(abs(p.x), abs(p.y), abs(p.z));
  let a = dot(q, vec3f(0, 0.525731086730957, 0.8506507873535156));
  let b = dot(q, vec3f(0.8506507873535156, 0, 0.525731086730957));
  let c = dot(q, vec3f(0.525731086730957, 0.8506507873535156, 0));
  return (max(max(a, b), c) - r);
}

fn item_15(p: vec3f, r: f32, h: f32) -> f32 {
  let w = sqrt(max(((r * r) - (h * h)), 0f));
  let qx = length(vec2f(p.x, p.z));
  let qy = p.y;
  let s = max(((((h - r) * qx) * qx) + ((w * w) * ((h + r) - (qy * 2f)))), ((h * qx) - (w * qy)));
  let case0 = (length(vec2f(qx, qy)) - r);
  let case1 = (h - qy);
  let case2 = length(vec2f((qx - w), (qy - h)));
  let inner = select(case2, case1, (qx < w));
  return select(inner, case0, (s < 0f));
}

struct RotStruct {
  cx: f32,
  sx: f32,
  cy: f32,
  sy: f32,
  cz: f32,
  sz: f32,
}

fn rotateVec3(v: vec3f, rot: RotStruct) -> vec3f {
  let x1 = ((v.x * rot.cy) + (v.z * rot.sy));
  let z1 = ((v.z * rot.cy) - (v.x * rot.sy));
  let y2 = ((v.y * rot.cx) - (z1 * rot.sx));
  let z2 = ((v.y * rot.sx) + (z1 * rot.cx));
  let x3 = ((x1 * rot.cz) - (y2 * rot.sz));
  let y3 = ((x1 * rot.sz) + (y2 * rot.cz));
  return vec3f(x3, y3, z2);
}"
