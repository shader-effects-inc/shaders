    for (var i = 0; (i < 10i); i++) {
      let mid = ((eLo + eHi) * 0.5f);
      let dm = sdfFn_1((ro + (rd * mid)));
      if ((dm > 0f)) {
        eLo = mid;
        dLo = dm;
      }
      else {
        eHi = mid;
        dHi = dm;
      }
    }
    let tEnter = (eLo + ((eHi - eLo) * clamp((dLo / max((dLo - dHi), 1e-9f)), 0f, 1f)));
    var tExit = tEnter;
    {
      let roB = (ro + (rd * tEnd));
      let span = ((tEnd - tStart) + 0.01f);
      var s = 0f;
      var sPrev = 0f;
      for (var i = 0; (i < steps); i++) {
        let p = (roB - (rd * s));
        let dd = sdfFn_1(p);
        if ((dd < 0f)) {
          break;
        }
        if ((s > span)) {
          break;
        }
        sPrev = s;
        s = (s + max(dd, 2e-3f));
      }
      var xLo = sPrev;
      var xHi = s;
      var hLo = sdfFn_1((roB - (rd * xLo)));
      var hHi = sdfFn_1((roB - (rd * xHi)));
      for (var i = 0; (i < 10i); i++) {
        let mid = ((xLo + xHi) * 0.5f);
        let dm = sdfFn_1((roB - (rd * mid)));
        if ((dm > 0f)) {
          xLo = mid;
          hLo = dm;
        }
        else {
          xHi = mid;
          hHi = dm;
        }
      }
      tExit = (tEnd - (xLo + ((xHi - xLo) * clamp((hLo / max((hLo - hHi), 1e-9f)), 0f, 1f))));
    }
    let halfChord = (max((tExit - tEnter), 0f) * 0.5f);
    fieldVal = (halfChord * -1f);
    viewDepth = tEnter;
    {
      let hp = (ro + (rd * tEnter));
      const e2 = 4e-3;
      let nlx = (sdfFn_1(vec3f((hp.x + e2), hp.y, hp.z)) - sdfFn_1(vec3f((hp.x - e2), hp.y, hp.z)));
      let nly = (sdfFn_1(vec3f(hp.x, (hp.y + e2), hp.z)) - sdfFn_1(vec3f(hp.x, (hp.y - e2), hp.z)));
      let nlz = (sdfFn_1(vec3f(hp.x, hp.y, (hp.z + e2))) - sdfFn_1(vec3f(hp.x, hp.y, (hp.z - e2))));
      let anx = abs(nlx);
      let anyv = abs(nly);
      let anz = abs(nlz);
      let branch1 = vec2f((hp.y + 2.17f), (hp.z + 5.31f));
      let branch2 = vec2f((hp.z + 7.73f), (hp.x + 1.13f));
      let branch3 = vec2f(hp.x, hp.y);
      let branch23 = select(branch3, branch2, (anyv >= anz));
      let innerPick = select(branch23, branch1, (anx >= anz));
      let pattern = select(branch23, innerPick, (anx >= anyv));
      patternU = pattern.x;
      patternV = pattern.y;
    }
  }
  return vec4f(fieldVal, patternU, patternV, viewDepth);
}

fn raymarchedField_3(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let ro0 = vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f);
  let rd0 = vec3f(0, 0, 1);
  let ro = rotateVec3(ro0, rot);
  let rd = rotateVec3(rd0, rot);
  let steps = i32(clamp((rBound * 220f), 96f, 384f));
  let b = dot(ro, rd);
  let perp = sqrt(max((dot(ro, ro) - (b * b)), 0f));
  let halfSpan = sqrt(max(((rBound * rBound) - (perp * perp)), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  var t = tStart;
  var tPrev = tStart;
  var minD = 10f;
  var tMinD = tStart;
  var hit = 0f;
  for (var i = 0; (i < steps); i++) {
    let p = (ro + (rd * t));
    let dd = sdfFn(p);
    if ((dd < minD)) {
      minD = dd;
      tMinD = t;
    }
    if ((dd < 0f)) {
      hit = 1f;
      break;
    }
    if ((t > tEnd)) {
      break;
    }
    tPrev = t;
    t = (t + max(dd, 2e-3f));
  }
  if (((hit < 0.5f) && (minD < 0.15f))) {
    let reach = (max(minD, 2e-3f) * 2f);
    var lo = (tMinD - reach);
    var hi = (tMinD + reach);
    for (var i = 0; (i < 5i); i++) {
      let m1 = (hi - ((hi - lo) * 0.618034f));
      let m2 = (lo + ((hi - lo) * 0.618034f));
      let f1 = sdfFn((ro + (rd * m1)));
      let f2 = sdfFn((ro + (rd * m2)));
      if ((f1 < f2)) {
        hi = m2;
      }
      else {
        lo = m1;
      }
    }
    minD = min(minD, sdfFn((ro + (rd * ((lo + hi) * 0.5f)))));
  }
  var fieldVal = minD;
  let patternU = 0f;
  let patternV = 0f;
  var viewDepth = (tEnd + 0.4f);
  if ((hit > 0.5f)) {
    var eLo = tPrev;
    var eHi = t;
    var dLo = sdfFn((ro + (rd * eLo)));
    var dHi = sdfFn((ro + (rd * eHi)));
    for (var i = 0; (i < 10i); i++) {
      let mid = ((eLo + eHi) * 0.5f);
      let dm = sdfFn((ro + (rd * mid)));
      if ((dm > 0f)) {
        eLo = mid;
        dLo = dm;
      }
      else {
        eHi = mid;
        dHi = dm;
      }
    }
    let tEnter = (eLo + ((eHi - eLo) * clamp((dLo / max((dLo - dHi), 1e-9f)), 0f, 1f)));
    var tExit = tEnter;
    {
      var sInPrev = eHi;
      var sIn = (eHi + 2e-3f);
      for (var i = 0; (i < steps); i++) {
        let dd = sdfFn((ro + (rd * sIn)));
        if ((dd >= 0f)) {
          break;
        }
        sInPrev = sIn;
        sIn = (sIn + max((dd * -1f), 2e-3f));
        if ((sIn > tEnd)) {
          break;
        }
      }
      var fLo = sInPrev;
      var fHi = sIn;
      var gLo = sdfFn((ro + (rd * fLo)));
      var gHi = sdfFn((ro + (rd * fHi)));
      for (var i = 0; (i < 10i); i++) {
        let mid = ((fLo + fHi) * 0.5f);
        let dm = sdfFn((ro + (rd * mid)));
        if ((dm < 0f)) {
          fLo = mid;
          gLo = dm;
        }
        else {
          fHi = mid;
          gHi = dm;
        }
      }
      tExit = (fLo + ((fHi - fLo) * clamp((gLo / min((gLo - gHi), -1e-9f)), 0f, 1f)));
    }
    let halfChord = (max((tExit - tEnter), 0f) * 0.5f);
    fieldVal = (halfChord * -1f);
    viewDepth = tEnter;
  }
  return vec4f(fieldVal, patternU, patternV, viewDepth);
}

fn sdfFn_2(p: vec3f) -> f32 {
  return sdf3d_sdSphere(p, params.pA);
}

fn raymarchedField_4(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let ro0 = vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f);
  let rd0 = vec3f(0, 0, 1);
  let ro = rotateVec3(ro0, rot);
  let rd = rotateVec3(rd0, rot);
  let steps = i32(clamp((rBound * 220f), 96f, 384f));
  let b = dot(ro, rd);
  let perp = sqrt(max((dot(ro, ro) - (b * b)), 0f));
  let halfSpan = sqrt(max(((rBound * rBound) - (perp * perp)), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  var t = tStart;
  var tPrev = tStart;
  var minD = 10f;
  var tMinD = tStart;
  var hit = 0f;
  for (var i = 0; (i < steps); i++) {
    let p = (ro + (rd * t));
    let dd = sdfFn_2(p);
    if ((dd < minD)) {
      minD = dd;
      tMinD = t;
    }
    if ((dd < 0f)) {
      hit = 1f;
      break;
    }
    if ((t > tEnd)) {
      break;
    }
    tPrev = t;
    t = (t + max(dd, 2e-3f));
  }
  if (((hit < 0.5f) && (minD < 0.15f))) {
    let reach = (max(minD, 2e-3f) * 2f);
    var lo = (tMinD - reach);
    var hi = (tMinD + reach);
    for (var i = 0; (i < 5i); i++) {
      let m1 = (hi - ((hi - lo) * 0.618034f));
      let m2 = (lo + ((hi - lo) * 0.618034f));
      let f1 = sdfFn_2((ro + (rd * m1)));
      let f2 = sdfFn_2((ro + (rd * m2)));
      if ((f1 < f2)) {
        hi = m2;
      }
      else {
        lo = m1;
      }
    }
    minD = min(minD, sdfFn_2((ro + (rd * ((lo + hi) * 0.5f)))));
  }
  var fieldVal = minD;
  var patternU = 0f;
  var patternV = 0f;
  var viewDepth = (tEnd + 0.4f);
  if ((hit > 0.5f)) {
    var eLo = tPrev;
    var eHi = t;
    var dLo = sdfFn_2((ro + (rd * eLo)));
    var dHi = sdfFn_2((ro + (rd * eHi)));
    for (var i = 0; (i < 10i); i++) {
      let mid = ((eLo + eHi) * 0.5f);
      let dm = sdfFn_2((ro + (rd * mid)));
      if ((dm > 0f)) {
        eLo = mid;
        dLo = dm;
      }
      else {
        eHi = mid;
        dHi = dm;
      }
    }
    let tEnter = (eLo + ((eHi - eLo) * clamp((dLo / max((dLo - dHi), 1e-9f)), 0f, 1f)));
    var tExit = tEnter;
    {
      let roB = (ro + (rd * tEnd));
      let span = ((tEnd - tStart) + 0.01f);
      var s = 0f;
      var sPrev = 0f;
      for (var i = 0; (i < steps); i++) {
        let p = (roB - (rd * s));
        let dd = sdfFn_2(p);
        if ((dd < 0f)) {
          break;
        }
        if ((s > span)) {
          break;
        }
        sPrev = s;
        s = (s + max(dd, 2e-3f));
      }
      var xLo = sPrev;
      var xHi = s;
      var hLo = sdfFn_2((roB - (rd * xLo)));
      var hHi = sdfFn_2((roB - (rd * xHi)));
      for (var i = 0; (i < 10i); i++) {
        let mid = ((xLo + xHi) * 0.5f);
        let dm = sdfFn_2((roB - (rd * mid)));
        if ((dm > 0f)) {
          xLo = mid;
          hLo = dm;
        }
        else {
          xHi = mid;
          hHi = dm;
        }
      }
      tExit = (tEnd - (xLo + ((xHi - xLo) * clamp((hLo / max((hLo - hHi), 1e-9f)), 0f, 1f))));
    }
    let halfChord = (max((tExit - tEnter), 0f) * 0.5f);
    fieldVal = (halfChord * -1f);
    viewDepth = tEnter;
    {
      let hp = (ro + (rd * tEnter));
      patternU = (hp.x + (hp.z * 0.7f));
      patternV = (hp.y + (hp.z * 0.5f));
    }
  }
  return vec4f(fieldVal, patternU, patternV, viewDepth);
}

@group(0) @binding(0) var field_1: texture_storage_2d<rgba32float, write>;

fn volumetricFieldMarch(cx: u32, cy: u32) {
  let p = (&params);
  let activeResF = f32((*p).activeRes);
  let uv = vec2f(((*p).originX + (((f32(cx) + 0.5f) / activeResF) * (*p).spanX)), ((*p).originY + (((f32(cy) + 0.5f) / activeResF) * (*p).spanY)));
  let field = raymarchedField_4(uv, (*p).rot, (*p).rBound);
  textureStore(field_1, vec2u(cx, cy), field);
}

struct SampleParams {
  originX: f32,
  originY: f32,
  spanX: f32,
  spanY: f32,
  activeResF: f32,
  rBound: f32,
}

@group(1) @binding(1) var<uniform> params_1: SampleParams;

@group(1) @binding(0) var field: texture_2d<f32>;

fn fieldFetchTexel(xi: f32, yi: f32) -> vec4f {
  let maxT = (params_1.activeResF - 1f);
  let tx = u32(clamp(xi, 0f, maxT));
  let ty = u32(clamp(yi, 0f, maxT));
  return textureLoad(field, vec2u(tx, ty), 0);
}

fn fieldSample(uv: vec2f) -> vec4f {
  let p = (&params_1);
  let uxc = clamp(uv.x, (*p).originX, ((*p).originX + (*p).spanX));
  let uyc = clamp(uv.y, (*p).originY, ((*p).originY + (*p).spanY));
  let outsideDist = length(vec2f((uv.x - uxc), (uv.y - uyc)));
  let px = ((((uxc - (*p).originX) / (*p).spanX) * (*p).activeResF) - 0.5f);
  let py = ((((uyc - (*p).originY) / (*p).spanY) * (*p).activeResF) - 0.5f);
  let x0 = floor(px);
  let y0 = floor(py);
  let fx = (px - x0);
  let fy = (py - y0);
  let tx2 = (fx * fx);
  let tx3 = (tx2 * fx);
  let wx0 = (((tx3 * -0.5f) + tx2) - (fx * 0.5f));
  let wx1 = (((tx3 * 1.5f) - (tx2 * 2.5f)) + 1f);
  let wx2 = (((tx3 * -1.5f) + (tx2 * 2f)) + (fx * 0.5f));
  let wx3 = ((tx3 * 0.5f) - (tx2 * 0.5f));
  let ty2 = (fy * fy);
  let ty3 = (ty2 * fy);
  let wy0 = (((ty3 * -0.5f) + ty2) - (fy * 0.5f));
  let wy1 = (((ty3 * 1.5f) - (ty2 * 2.5f)) + 1f);
  let wy2 = (((ty3 * -1.5f) + (ty2 * 2f)) + (fy * 0.5f));
  let wy3 = ((ty3 * 0.5f) - (ty2 * 0.5f));
  let k00 = fieldFetchTexel((x0 - 1f), (y0 - 1f));
  let k01 = fieldFetchTexel(x0, (y0 - 1f));
  let k02 = fieldFetchTexel((x0 + 1f), (y0 - 1f));
  let k03 = fieldFetchTexel((x0 + 2f), (y0 - 1f));
  let k10 = fieldFetchTexel((x0 - 1f), y0);
  let k11 = fieldFetchTexel(x0, y0);
  let k12 = fieldFetchTexel((x0 + 1f), y0);
  let k13 = fieldFetchTexel((x0 + 2f), y0);
  let k20 = fieldFetchTexel((x0 - 1f), (y0 + 1f));
  let k21 = fieldFetchTexel(x0, (y0 + 1f));
  let k22 = fieldFetchTexel((x0 + 1f), (y0 + 1f));
  let k23 = fieldFetchTexel((x0 + 2f), (y0 + 1f));
  let k30 = fieldFetchTexel((x0 - 1f), (y0 + 2f));
  let k31 = fieldFetchTexel(x0, (y0 + 2f));
  let k32 = fieldFetchTexel((x0 + 1f), (y0 + 2f));
  let k33 = fieldFetchTexel((x0 + 2f), (y0 + 2f));
  let rAcc = (((((((((((((((((k00.r * wx0) * wy0) + ((k01.r * wx1) * wy0)) + ((k02.r * wx2) * wy0)) + ((k03.r * wx3) * wy0)) + ((k10.r * wx0) * wy1)) + ((k11.r * wx1) * wy1)) + ((k12.r * wx2) * wy1)) + ((k13.r * wx3) * wy1)) + ((k20.r * wx0) * wy2)) + ((k21.r * wx1) * wy2)) + ((k22.r * wx2) * wy2)) + ((k23.r * wx3) * wy2)) + ((k30.r * wx0) * wy3)) + ((k31.r * wx1) * wy3)) + ((k32.r * wx2) * wy3)) + ((k33.r * wx3) * wy3));
  let aAcc = (((((((((((((((((k00.a * wx0) * wy0) + ((k01.a * wx1) * wy0)) + ((k02.a * wx2) * wy0)) + ((k03.a * wx3) * wy0)) + ((k10.a * wx0) * wy1)) + ((k11.a * wx1) * wy1)) + ((k12.a * wx2) * wy1)) + ((k13.a * wx3) * wy1)) + ((k20.a * wx0) * wy2)) + ((k21.a * wx1) * wy2)) + ((k22.a * wx2) * wy2)) + ((k23.a * wx3) * wy2)) + ((k30.a * wx0) * wy3)) + ((k31.a * wx1) * wy3)) + ((k32.a * wx2) * wy3)) + ((k33.a * wx3) * wy3));
  let bl = mix(mix(k11, k12, fx), mix(k21, k22, fx), fy);
  let rMin = min(min(k11.r, k12.r), min(k21.r, k22.r));
  let rMax = max(max(k11.r, k12.r), max(k21.r, k22.r));
  let aMin = min(min(k11.a, k12.a), min(k21.a, k22.a));
  let aMax = max(max(k11.a, k12.a), max(k21.a, k22.a));
  let aOut = clamp(aAcc, aMin, aMax);
  let rNear = (clamp(rAcc, rMin, rMax) + outsideDist);
  let rCircle = (length(vec2f((uv.x - 0.5f), (uv.y - 0.5f))) - (*p).rBound);
  let rOut = mix(rNear, max(rCircle, rNear), smoothstep(0f, 0.25f, outsideDist));
  return vec4f(rOut, bl.g, bl.b, aOut);
}

fn fieldSampleFast(uv: vec2f) -> vec4f {
  let p = (&params_1);
  let uxc = clamp(uv.x, (*p).originX, ((*p).originX + (*p).spanX));
  let uyc = clamp(uv.y, (*p).originY, ((*p).originY + (*p).spanY));
  let outsideDist = length(vec2f((uv.x - uxc), (uv.y - uyc)));
  let px = ((((uxc - (*p).originX) / (*p).spanX) * (*p).activeResF) - 0.5f);
  let py = ((((uyc - (*p).originY) / (*p).spanY) * (*p).activeResF) - 0.5f);
  let x0 = floor(px);
  let y0 = floor(py);
  let fx = (px - x0);
  let fy = (py - y0);
  let t00 = fieldFetchTexel(x0, y0);
  let t10 = fieldFetchTexel((x0 + 1f), y0);
  let t01 = fieldFetchTexel(x0, (y0 + 1f));
  let t11 = fieldFetchTexel((x0 + 1f), (y0 + 1f));
  let bl = mix(mix(t00, t10, fx), mix(t01, t11, fx), fy);
  let rNear = (bl.r + outsideDist);
  let rCircle = (length(vec2f((uv.x - 0.5f), (uv.y - 0.5f))) - (*p).rBound);
  let rOut = mix(rNear, max(rCircle, rNear), smoothstep(0f, 0.25f, outsideDist));
  return vec4f(rOut, bl.g, bl.b, bl.a);
}"
`;
