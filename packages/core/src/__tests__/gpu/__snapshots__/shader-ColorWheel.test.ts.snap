exports[`ColorWheel (a) rainbow mode > final pass calls colorWheelRainbow (no mixColors, no RTT) > rainbow-final-pass 1`] = `
"fn colorWheelRainbow(t: f32) -> vec4f {
  let h6 = (t * 6f);
  let r = clamp((abs((h6 - 3f)) - 1f), 0f, 1f);
  let g = clamp((2f - abs((h6 - 2f))), 0f, 1f);
  let b = clamp((2f - abs((h6 - 4f))), 0f, 1f);
  return vec4f(r, g, b, 1f);
}

fn geom_aspectOf(viewport: vec2f) -> f32 {
  return (viewport.x / max(viewport.y, 1e-6f));
}

fn canvasCentredDelta(uv: vec2f, aspect: f32) -> vec2f {
  return vec2f(((uv.x * aspect) - (aspect * 0.5f)), (uv.y - 0.5f));
}

fn directionalProjection(p: vec2f, cosA: f32, sinA: f32) -> f32 {
  return ((p.x * cosA) + (p.y * sinA));
}

fn colorWheelT(uv: vec2f, viewport: vec2f, angle: f32, scale: f32, animTime: f32) -> f32 {
  let angleRad = (angle * 0.017453292519943295f);
  let aspect = geom_aspectOf(viewport);
  let projectedCoord = (directionalProjection(canvasCentredDelta(uv, aspect), cos(angleRad), sin(angleRad)) + (aspect * 0.5f));
  return fract((((projectedCoord * scale) * 0.2f) + animTime));
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  colorA: vec4f,
  colorB: vec4f,
  colorC: vec4f,
  scale: f32,
  angle: f32,
  speed: f32,
  colorSpace: f32,
  _opacity: f32,
  _animTime: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_cw: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = colorWheelRainbow(colorWheelT(uv, uniforms._sys.viewportSize, uniforms.n_cw.angle, uniforms.n_cw.scale, uniforms.n_cw._animTime));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;

exports[`ColorWheel (b) custom mode > final pass calls colorWheelSelect + mixColors > custom-final-pass 1`] = `
"fn colorWheelPhase(t: f32) -> vec2f {
  let t3 = (t * 3f);
  return vec2f(fract(t3), floor(t3));
}

fn geom_aspectOf(viewport: vec2f) -> f32 {
  return (viewport.x / max(viewport.y, 1e-6f));
}

fn canvasCentredDelta(uv: vec2f, aspect: f32) -> vec2f {
  return vec2f(((uv.x * aspect) - (aspect * 0.5f)), (uv.y - 0.5f));
}

fn directionalProjection(p: vec2f, cosA: f32, sinA: f32) -> f32 {
  return ((p.x * cosA) + (p.y * sinA));
}

fn colorWheelT(uv: vec2f, viewport: vec2f, angle: f32, scale: f32, animTime: f32) -> f32 {
  let angleRad = (angle * 0.017453292519943295f);
  let aspect = geom_aspectOf(viewport);
  let projectedCoord = (directionalProjection(canvasCentredDelta(uv, aspect), cos(angleRad), sin(angleRad)) + (aspect * 0.5f));
  return fract((((projectedCoord * scale) * 0.2f) + animTime));
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  colorA: vec4f,
  colorB: vec4f,
  colorC: vec4f,
  scale: f32,
  angle: f32,
  speed: f32,
  colorSpace: f32,
  _opacity: f32,
  _animTime: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_cw: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn colorWheelSelect(c01: vec4f, c12: vec4f, c20: vec4f, floorT3: f32) -> vec4f {
  let seg1 = mix(c20, c12, step(floorT3, 1.5f));
  return mix(seg1, c01, step(floorT3, 0.5f));
}

fn p3ToSRGB(p3: vec3f) -> vec3f {
  let r = (((p3.x * 1.2249401f) - (p3.y * 0.2249404f)) - (p3.z * 0f));
  let g = (((p3.x * -0.0420569f) + (p3.y * 1.0420571f)) + (p3.z * 0f));
  let b = (((p3.x * -0.0196376f) - (p3.y * 0.0786361f)) + (p3.z * 1.0982735f));
  return vec3f(r, g, b);
}

fn rgbToOklab(rgb: vec3f) -> vec3f {
  let r = rgb.x;
  let g = rgb.y;
  let b = rgb.z;
  let l = (((r * 0.4122214708f) + (g * 0.5363325363f)) + (b * 0.0514459929f));
  let m = ((r * 0.2119034982f) + ((g * 0.6806995451f) + (b * 0.1073969566f)));
  let s = (((r * 0.0883024619f) + (g * 0.2817188376f)) + (b * 0.6299787005f));
  let l_ = (sign(l) * pow(abs(l), 0.3333333333333333f));
  let m_ = (sign(m) * pow(abs(m), 0.3333333333333333f));
  let s_ = (sign(s) * pow(abs(s), 0.3333333333333333f));
  return vec3f((((l_ * 0.2104542553f) + (m_ * 0.793617785f)) - (s_ * 0.0040720468f)), (((l_ * 1.9779984951f) - (m_ * 2.428592205f)) + (s_ * 0.4505937099f)), (((l_ * 0.0259040371f) + (m_ * 0.7827717662f)) - (s_ * 0.808675766f)));
}

fn oklabToOklch(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let C = sqrt(((a * a) + (b * b)));
  let h = atan2(b, a);
  return vec3f(L, C, h);
}

fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn mixHueShortest(hA: f32, cA: f32, hB: f32, cB: f32, wB: f32, sw: f32, achromatic: f32) -> f32 {
  let hueA = select(hA, hB, (cA < achromatic));
  let hueB = select(hB, hueA, (cB < achromatic));
  let diff = (hueB - hueA);
  let wrapped = (diff - (floor(((diff + 3.14159265359f) * 0.15915494309f)) * 6.28318530718f));
  return (hueA + (wrapped * (wB / sw)));
}

fn awMixOklch(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  let m = awMix(a, b, wA, wB, sw);
  return vec3f(m.x, m.y, mixHueShortest(a.z, a.y, b.z, b.y, wB, sw, 1e-3f));
}

fn oklchToOklab(lch: vec3f) -> vec3f {
  let L = lch.x;
  let C = lch.y;
  let h = lch.z;
  return vec3f(L, (C * cos(h)), (C * sin(h)));
}

fn oklabToRgb(lab: vec3f) -> vec3f {
  let L = lab.x;
  let a = lab.y;
  let b = lab.z;
  let l_ = ((L + (a * 0.3963377774f)) + (b * 0.2158037573f));
  let m_ = ((L - (a * 0.1055613458f)) - (b * 0.0638541728f));
  let s_ = ((L - (a * 0.0894841775f)) - (b * 1.291485548f));
  let l = pow(l_, 3f);
  let m = pow(m_, 3f);
  let s = pow(s_, 3f);
  return vec3f((((l * 4.0767416621f) - (m * 3.3077115913f)) + (s * 0.2309699292f)), (((l * -1.2684380046f) + (m * 2.6097574011f)) - (s * 0.3413193965f)), (((l * -0.0041960863f) - (m * 0.7034186147f)) + (s * 1.707614701f)));
}

fn sRGBToP3(srgb: vec3f) -> vec3f {
  let r = (((srgb.x * 0.8224621f) + (srgb.y * 0.177538f)) + (srgb.z * 0f));
  let g = (((srgb.x * 0.0331941f) + (srgb.y * 0.9668058f)) + (srgb.z * 0f));
  let b = (((srgb.x * 0.0170826f) + (srgb.y * 0.0723974f)) + (srgb.z * 0.9105199f));
  return vec3f(r, g, b);
}

fn mixColors(colorA: vec4f, colorB: vec4f, t: f32) -> vec4f {
  let weightA = (colorA.w * (1f - t));
  let weightB = (colorB.w * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let oklchA = oklabToOklch(rgbToOklab(p3ToSRGB(colorA.xyz)));
  let oklchB = oklabToOklch(rgbToOklab(p3ToSRGB(colorB.xyz)));
  let mixed = awMixOklch(oklchA, oklchB, weightA, weightB, safeWeight);
  let rgb = sRGBToP3(oklabToRgb(oklchToOklab(mixed)));
  return vec4f(rgb, totalWeight);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let wheelPhase_0 = colorWheelPhase(colorWheelT(uv, uniforms._sys.viewportSize, uniforms.n_cw.angle, uniforms.n_cw.scale, uniforms.n_cw._animTime));
  var composed_1 = colorWheelSelect(mixColors(uniforms.n_cw.colorA, uniforms.n_cw.colorB, wheelPhase_0.x), mixColors(uniforms.n_cw.colorB, uniforms.n_cw.colorC, wheelPhase_0.x), mixColors(uniforms.n_cw.colorC, uniforms.n_cw.colorA, wheelPhase_0.x), wheelPhase_0.y);
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;
